{% doc %}
@prompt
Luxury editorial popup banner — left image carousel, right text with generous whitespace and decorative accents.
Shows on every landing page on first visit, then reappears every 3 minutes on page navigation.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
/* ── POPUP OVERLAY ── */
.ai-popup-banner-overlay-{{ ai_gen_id }} {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.45);
  z-index: 9999;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  -webkit-backdrop-filter: blur(3px);
  backdrop-filter: blur(3px);
}
.ai-popup-banner-overlay-{{ ai_gen_id }}.is-visible {
  display: flex;
  opacity: 1;
}
.ai-popup-banner-overlay-{{ ai_gen_id }}.is-closing {
  opacity: 0;
  transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}
.ai-popup-banner-overlay-{{ ai_gen_id }}.is-closing .ai-popup-banner-{{ ai_gen_id }} {
  transform: scale(0.96) translateY(10px);
  opacity: 0;
  transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.5s ease;
}

/* ── POPUP CONTAINER ── */
.ai-popup-banner-{{ ai_gen_id }} {
  position: relative;
  width: 88%;
  max-width: 380px;
  max-height: 85dvh;
  overflow: hidden;
  background-color: {{ block.settings.background_color }};
  border-radius: 6px;
  box-shadow: 0 30px 80px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(255, 255, 255, 0.05);
  animation: ai-popup-fade-in-{{ ai_gen_id }} 1s cubic-bezier(0.16, 1, 0.3, 1) both;
  display: flex;
  flex-direction: column;
}
@media (min-width: 768px) {
  .ai-popup-banner-{{ ai_gen_id }} {
    width: 92%;
    max-width: 440px;
    max-height: 90vh;
    border-radius: 10px;
  }
}
@keyframes ai-popup-fade-in-{{ ai_gen_id }} {
  from {
    opacity: 0;
    transform: scale(0.94) translateY(20px);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

/* ── CLOSE BUTTON ── */
.ai-popup-banner__close-{{ ai_gen_id }} {
  position: absolute;
  top: 12px;
  right: 12px;
  width: 36px;
  height: 36px;
  background-color: rgba(0, 0, 0, 0.35);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
  transition: background-color 0.3s ease, transform 0.2s ease;
}
.ai-popup-banner__close-{{ ai_gen_id }}:hover {
  background-color: rgba(0, 0, 0, 0.6);
  transform: scale(1.05);
}
.ai-popup-banner__close-{{ ai_gen_id }} svg {
  width: 12px;
  height: 12px;
  stroke: #ffffff;
  stroke-width: 2;
  fill: none;
}

/* ── GRID ── */
.ai-popup-banner__grid-{{ ai_gen_id }} {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
}

/* ── CAROUSEL ── */
.ai-popup-banner__carousel-column-{{ ai_gen_id }} {
  position: relative;
  width: 100%;
  overflow: hidden;
}
.ai-popup-banner__carousel-wrapper-{{ ai_gen_id }} {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 3;
  overflow: hidden;
  background-color: {{ block.settings.background_color }};
  border-radius: 6px 6px 0 0;
}
@media (min-width: 768px) {
  .ai-popup-banner__carousel-wrapper-{{ ai_gen_id }} {
    aspect-ratio: {{ block.settings.carousel_aspect_ratio }};
    border-radius: 10px 10px 0 0;
  }
}
.ai-popup-banner__carousel-track-{{ ai_gen_id }} {
  position: relative;
  width: 100%;
  height: 100%;
}
.ai-popup-banner__carousel-slide-{{ ai_gen_id }} {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  transition: opacity {{ block.settings.transition_duration }}ms ease-in-out;
  pointer-events: none;
}
.ai-popup-banner__carousel-slide-{{ ai_gen_id }}.active {
  opacity: 1;
  pointer-events: auto;
}
.ai-popup-banner__carousel-slide-{{ ai_gen_id }} img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.ai-popup-banner__carousel-placeholder-{{ ai_gen_id }} {
  width: 100%;
  height: 100%;
  background-color: #f4f4f4;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ai-popup-banner__carousel-placeholder-{{ ai_gen_id }} svg {
  width: 100%;
  height: 100%;
  max-width: 400px;
  max-height: 400px;
}
.ai-popup-banner__control-{{ ai_gen_id }} {
  position: absolute;
  bottom: {{ block.settings.control_position_bottom }}px;
  left: {{ block.settings.control_position_left }}px;
  width: {{ block.settings.control_size }}px;
  height: {{ block.settings.control_size }}px;
  background-color: {{ block.settings.control_bg_color }};
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  transition: opacity 0.3s ease;
}
.ai-popup-banner__control-{{ ai_gen_id }}:hover {
  opacity: 0.8;
}
.ai-popup-banner__control-icon-{{ ai_gen_id }} {
  width: 50%;
  height: 50%;
  fill: {{ block.settings.control_icon_color }};
}

/* ── TEXT COLUMN ── */
.ai-popup-banner__text-column-{{ ai_gen_id }} {
  background-color: {{ block.settings.background_color }};
  padding: 24px {{ block.settings.mobile_side_padding }}px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}
@media (min-width: 768px) {
  .ai-popup-banner__text-column-{{ ai_gen_id }} {
    padding: {{ block.settings.text_padding_mobile }}px {{ block.settings.mobile_side_padding }}px;
  }
}
.ai-popup-banner__text-content-{{ ai_gen_id }} {
  max-width: 100%;
  text-align: center;
}

/* Decorative accent line */
.ai-popup-banner__accent-{{ ai_gen_id }} {
  width: 40px;
  height: 1px;
  background-color: {{ block.settings.headline_color }};
  margin: 0 auto 16px auto;
  opacity: 0.2;
}

/* Pill / tag */
.ai-popup-banner__pill-{{ ai_gen_id }} {
  display: inline-block;
  background-color: {{ block.settings.pill_bg_color }};
  color: {{ block.settings.pill_text_color }};
  padding: {{ block.settings.pill_padding_vertical }}px {{ block.settings.pill_padding_horizontal }}px;
  font-size: {{ block.settings.pill_font_size }}px;
  text-transform: uppercase;
  letter-spacing: {{ block.settings.pill_letter_spacing }}px;
  font-weight: 500;
  border-radius: {{ block.settings.pill_border_radius }}px;
  margin-bottom: 16px;
}

/* Headline — modern mixed-case style */
.ai-popup-banner__headline-{{ ai_gen_id }} {
  font-size: clamp(22px, 5.5vw, {{ block.settings.headline_font_size_mobile }}px);
  line-height: {{ block.settings.headline_line_height }};
  color: {{ block.settings.headline_color }};
  font-weight: {{ block.settings.headline_font_weight }};
  margin: 0 0 12px 0;
  letter-spacing: -0.01em;
  text-align: center;
  font-style: normal;
}

/* Subtext */
.ai-popup-banner__subtext-{{ ai_gen_id }} {
  font-size: {{ block.settings.subtext_font_size }}px;
  color: {{ block.settings.subtext_color }};
  margin: 0 0 20px 0;
  font-weight: 300;
  line-height: 1.5;
  letter-spacing: 0.01em;
}
.ai-popup-banner__subtext-{{ ai_gen_id }} a {
  text-decoration: underline;
  text-underline-offset: 2px;
  color: {{ block.settings.subtext_color }};
}

/* CTA button — modern filled style */
.ai-popup-banner__cta-{{ ai_gen_id }} {
  display: inline-block;
  font-size: {{ block.settings.cta_font_size }}px;
  color: {{ block.settings.background_color }};
  background-color: {{ block.settings.cta_color }};
  text-decoration: none;
  text-transform: uppercase;
  letter-spacing: {{ block.settings.cta_letter_spacing }}px;
  font-weight: 500;
  padding: 14px 36px;
  border: none;
  transition: opacity 0.3s ease, transform 0.2s ease;
}
.ai-popup-banner__cta-{{ ai_gen_id }}:hover {
  opacity: 0.85;
  transform: translateY(-1px);
}
{% endstyle %}
<popup-carousel-{{ ai_gen_id }}
  class="ai-popup-banner-overlay-{{ ai_gen_id }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-interval="{{ block.settings.autoplay_interval }}"
  data-pause-on-hover="{{ block.settings.pause_on_hover }}"
  data-popup-delay="{{ block.settings.popup_delay }}"
  data-reshow-interval="{{ block.settings.reshow_interval }}"
{{ block.shopify_attributes }}
>
  <div class="ai-popup-banner-{{ ai_gen_id }}">
    <button class="ai-popup-banner__close-{{ ai_gen_id }}" aria-label="Close popup" data-close>
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <line x1="6" y1="6" x2="18" y2="18"/>
        <line x1="18" y1="6" x2="6" y2="18"/>
      </svg>
    </button>
    <div class="ai-popup-banner__grid-{{ ai_gen_id }}">
      <div class="ai-popup-banner__carousel-column-{{ ai_gen_id }}">
        <div class="ai-popup-banner__carousel-wrapper-{{ ai_gen_id }}">
          <div class="ai-popup-banner__carousel-track-{{ ai_gen_id }}">
{% if block.settings.image_1 != blank or block.settings.image_2 != blank or block.settings.image_3 != blank or block.settings.image_4 != blank or block.settings.image_5 != blank %}
{% for i in (1..5) %}
{% assign image_key = 'image_' | append: i %}
{% assign image = block.settings[image_key] %}
{% if image != blank %}
                  <div class="ai-popup-banner__carousel-slide-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}" data-slide="{{ forloop.index }}">
                    <img
                      src="{{ image | image_url: width: 1400 }}"
                      alt="{{ image.alt | escape }}"
                      loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                      width="{{ image.width }}"
                      height="{{ image.height }}"
                    >
                  </div>
{% endif %}
{% endfor %}
{% else %}
              <div class="ai-popup-banner__carousel-slide-{{ ai_gen_id }} active" data-slide="1">
                <div class="ai-popup-banner__carousel-placeholder-{{ ai_gen_id }}">
{{ 'hero-apparel-1' | placeholder_svg_tag }}
                </div>
              </div>
{% endif %}
          </div>
{% if block.settings.show_controls %}
            <button
              class="ai-popup-banner__control-{{ ai_gen_id }}"
              aria-label="Toggle carousel playback"
              data-control
            >
              <svg class="ai-popup-banner__control-icon-{{ ai_gen_id }}" data-pause-icon viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <rect x="6" y="4" width="4" height="16" rx="1"/>
                <rect x="14" y="4" width="4" height="16" rx="1"/>
              </svg>
              <svg class="ai-popup-banner__control-icon-{{ ai_gen_id }}" data-play-icon style="display: none;" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </button>
{% endif %}
        </div>
      </div>
      <div class="ai-popup-banner__text-column-{{ ai_gen_id }}">
        <div class="ai-popup-banner__text-content-{{ ai_gen_id }}">
          <div class="ai-popup-banner__accent-{{ ai_gen_id }}"></div>
{% if block.settings.pill_text != blank %}
            <div class="ai-popup-banner__pill-{{ ai_gen_id }}">
{{ block.settings.pill_text }}
            </div>
{% endif %}
{% if block.settings.headline != blank %}
            <h2 class="ai-popup-banner__headline-{{ ai_gen_id }}">
{{ block.settings.headline }}
            </h2>
{% endif %}
{% if block.settings.subtext != blank %}
            <div class="ai-popup-banner__subtext-{{ ai_gen_id }}">
{{ block.settings.subtext }}
            </div>
{% endif %}
{% if block.settings.cta_text != blank and block.settings.cta_link != blank %}
            <a href="{{ block.settings.cta_link }}" class="ai-popup-banner__cta-{{ ai_gen_id }}">
{{ block.settings.cta_text }}
            </a>
{% endif %}
        </div>
      </div>
    </div>
  </div>
</popup-carousel-{{ ai_gen_id }}>
<script>
(function() {
  var STORAGE_KEY = 'ai_popup_dismissed_{{ ai_gen_id }}';

  class PopupCarousel{{ ai_gen_id }} extends HTMLElement {
    constructor() {
      super();
      this.currentSlide = 0;
      this.isPermanentlyPaused = false;
      this.intervalId = null;
      this.slides = [];
    }

    connectedCallback() {
      this.slides = Array.from(this.querySelectorAll('.ai-popup-banner__carousel-slide-{{ ai_gen_id }}'));
      this.controlButton = this.querySelector('[data-control]');
      this.pauseIcon = this.querySelector('[data-pause-icon]');
      this.playIcon = this.querySelector('[data-play-icon]');
      this.closeButton = this.querySelector('[data-close]');
      this.autoplay = this.dataset.autoplay === 'true';
      this.interval = parseInt(this.dataset.interval) || 4000;
      this.pauseOnHover = this.dataset.pauseOnHover === 'true';
      this.popupDelay = parseInt(this.dataset.popupDelay) || 1500;
      this.reshowInterval = (parseInt(this.dataset.reshowInterval) || 3) * 60000;
      this.reshowTimerId = null;

      this.setupCloseListeners();

      if (this.slides.length > 1) {
        this.setupCarouselListeners();
      } else if (this.controlButton) {
        this.controlButton.style.display = 'none';
      }

      /* ── Recurring popup logic ──
         First visit on any page: always show immediately.
         After dismiss: re-show after reshowInterval (default 3 min)
         on the same page — no navigation required. On new page loads
         it also checks the stored timestamp. */
      var lastDismissed = parseInt(localStorage.getItem(STORAGE_KEY), 10);
      var now = Date.now();

      if (lastDismissed && (now - lastDismissed < this.reshowInterval)) {
        /* Dismissed recently — schedule reshow for remaining time */
        var remaining = this.reshowInterval - (now - lastDismissed);
        this.scheduleReshow(remaining);
        return;
      }

      /* First visit or enough time has passed — show now */
      this.showPopup();
    }

    setupCloseListeners() {
      var self = this;
      this.closeButton.addEventListener('click', function() {
        self.closePopup();
      });
      this.addEventListener('click', function(e) {
        if (e.target === self) {
          self.closePopup();
        }
      });
    }

    showPopup() {
      var self = this;
      setTimeout(function() {
        self.classList.add('is-visible');
        document.body.style.overflow = 'hidden';
        if (self.slides.length > 1 && self.autoplay) {
          self.startAutoplay();
        }
      }, this.popupDelay);
    }

    scheduleReshow(delay) {
      var self = this;
      if (this.reshowTimerId) clearTimeout(this.reshowTimerId);
      this.reshowTimerId = setTimeout(function() {
        self.currentSlide = 0;
        self.slides.forEach(function(s, i) {
          s.classList.toggle('active', i === 0);
        });
        self.showPopup();
      }, delay);
    }

    closePopup() {
      var self = this;
      this.classList.add('is-closing');
      this.clearAutoplay();
      localStorage.setItem(STORAGE_KEY, String(Date.now()));
      setTimeout(function() {
        self.classList.remove('is-visible', 'is-closing');
        document.body.style.overflow = '';
        /* Schedule the popup to reappear after reshowInterval */
        self.scheduleReshow(self.reshowInterval);
      }, 600);
    }

    setupCarouselListeners() {
      if (this.controlButton) {
        this.controlButton.addEventListener('click', this.togglePlayPause.bind(this));
      }
      if (this.pauseOnHover) {
        var wrapper = this.querySelector('.ai-popup-banner__carousel-wrapper-{{ ai_gen_id }}');
        wrapper.addEventListener('mouseenter', function() {
          if (!this.isPermanentlyPaused) {
            this.clearAutoplay();
          }
        }.bind(this));
        wrapper.addEventListener('mouseleave', function() {
          if (!this.isPermanentlyPaused && this.autoplay) {
            this.startAutoplay();
          }
        }.bind(this));
      }
    }

    startAutoplay() {
      this.clearAutoplay();
      this.intervalId = setInterval(this.nextSlide.bind(this), this.interval);
    }

    clearAutoplay() {
      if (this.intervalId) {
        clearInterval(this.intervalId);
        this.intervalId = null;
      }
    }

    nextSlide() {
      this.slides[this.currentSlide].classList.remove('active');
      this.currentSlide = (this.currentSlide + 1) % this.slides.length;
      this.slides[this.currentSlide].classList.add('active');
    }

    togglePlayPause() {
      if (!this.isPermanentlyPaused) {
        this.manualPause();
      } else {
        this.manualPlay();
      }
    }

    manualPause() {
      this.isPermanentlyPaused = true;
      this.clearAutoplay();
      this.updateControlIcons(false);
    }

    manualPlay() {
      this.isPermanentlyPaused = false;
      this.startAutoplay();
      this.updateControlIcons(true);
    }

    updateControlIcons(playing) {
      if (this.pauseIcon && this.playIcon) {
        this.pauseIcon.style.display = playing ? 'block' : 'none';
        this.playIcon.style.display = playing ? 'none' : 'block';
      }
    }

    disconnectedCallback() {
      this.clearAutoplay();
      if (this.reshowTimerId) clearTimeout(this.reshowTimerId);
    }
  }

  customElements.define('popup-carousel-{{ ai_gen_id }}', PopupCarousel{{ ai_gen_id }});
})();
</script>
{% schema %}
{
  "name": "Popup banner carousel",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Popup"
    },
    {
      "type": "range",
      "id": "popup_delay",
      "min": 0,
      "max": 5000,
      "step": 500,
      "unit": "ms",
      "label": "Popup delay",
      "default": 1500
    },
    {
      "type": "range",
      "id": "reshow_interval",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "min",
      "label": "Reshow after (minutes)",
      "default": 3
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "mobile_side_padding",
      "min": 15,
      "max": 40,
      "step": 5,
      "unit": "px",
      "label": "Side padding",
      "default": 25
    },
    {
      "type": "header",
      "content": "Carousel images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Image 4"
    },
    {
      "type": "image_picker",
      "id": "image_5",
      "label": "Image 5"
    },
    {
      "type": "select",
      "id": "carousel_aspect_ratio",
      "label": "Aspect ratio",
      "options": [
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "5 / 6", "label": "Portrait (5:6)" },
        { "value": "16 / 9", "label": "Landscape (16:9)" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "header",
      "content": "Carousel behavior"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "min": 2000,
      "max": 8000,
      "step": 500,
      "unit": "ms",
      "label": "Autoplay interval",
      "default": 4000
    },
    {
      "type": "range",
      "id": "transition_duration",
      "min": 300,
      "max": 1000,
      "step": 100,
      "unit": "ms",
      "label": "Transition duration",
      "default": 700
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Carousel controls"
    },
    {
      "type": "checkbox",
      "id": "show_controls",
      "label": "Show play/pause button",
      "default": true
    },
    {
      "type": "range",
      "id": "control_size",
      "min": 30,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Button size",
      "default": 40
    },
    {
      "type": "color",
      "id": "control_bg_color",
      "label": "Button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "control_icon_color",
      "label": "Icon color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "control_position_bottom",
      "min": 10,
      "max": 40,
      "step": 5,
      "unit": "px",
      "label": "Position from bottom",
      "default": 20
    },
    {
      "type": "range",
      "id": "control_position_left",
      "min": 10,
      "max": 40,
      "step": 5,
      "unit": "px",
      "label": "Position from left",
      "default": 20
    },
    {
      "type": "header",
      "content": "Text content"
    },
    {
      "type": "text",
      "id": "pill_text",
      "label": "Pill text",
      "default": "LIMITED TIME ONLY"
    },
    {
      "type": "color",
      "id": "pill_bg_color",
      "label": "Pill background",
      "default": "#f4c2c2"
    },
    {
      "type": "color",
      "id": "pill_text_color",
      "label": "Pill text",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "pill_padding_vertical",
      "min": 4,
      "max": 12,
      "step": 2,
