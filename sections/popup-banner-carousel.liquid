{% doc %}
@prompt
Ultra-luxury minimal popup — left image carousel, right text panel.
White & gold palette, serif typography, generous whitespace, refined accents.
Shows on first visit, then reappears every 3 minutes on page navigation.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}

/* ── OVERLAY ── */
.ai-popup-banner-overlay-{{ ai_gen_id }} {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(15, 12, 8, 0.55);
  z-index: 9999;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  -webkit-backdrop-filter: blur(6px);
  backdrop-filter: blur(6px);
}
.ai-popup-banner-overlay-{{ ai_gen_id }}.is-visible {
  display: flex;
  opacity: 1;
}
.ai-popup-banner-overlay-{{ ai_gen_id }}.is-closing {
  opacity: 0;
  transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1);
}
.ai-popup-banner-overlay-{{ ai_gen_id }}.is-closing .ai-popup-banner-{{ ai_gen_id }} {
  transform: scale(0.97) translateY(8px);
  opacity: 0;
  transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.6s ease;
}

/* ── POPUP CONTAINER ── */
.ai-popup-banner-{{ ai_gen_id }} {
  position: relative;
  width: 90%;
  max-width: 380px;
  max-height: 85dvh;
  overflow: hidden;
  background-color: {{ block.settings.background_color }};
  border: 1px solid rgba(183, 155, 111, 0.2);
  box-shadow:
    0 40px 100px rgba(0, 0, 0, 0.35),
    0 0 0 1px rgba(183, 155, 111, 0.08),
    inset 0 0 80px rgba(183, 155, 111, 0.02);
  animation: ai-popup-fade-in-{{ ai_gen_id }} 1.1s cubic-bezier(0.16, 1, 0.3, 1) both;
  display: flex;
  flex-direction: column;
}
@media (min-width: 768px) {
  .ai-popup-banner-{{ ai_gen_id }} {
    flex-direction: row;
    width: 94%;
    max-width: 840px;
    max-height: 90vh;
  }
}
@keyframes ai-popup-fade-in-{{ ai_gen_id }} {
  from {
    opacity: 0;
    transform: scale(0.95) translateY(15px);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

/* ── CLOSE BUTTON — minimal X ── */
.ai-popup-banner__close-{{ ai_gen_id }} {
  position: absolute;
  top: 14px;
  right: 14px;
  width: 32px;
  height: 32px;
  background: transparent;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
  opacity: 0.5;
  transition: opacity 0.3s ease;
}
.ai-popup-banner__close-{{ ai_gen_id }}:hover {
  opacity: 1;
}
.ai-popup-banner__close-{{ ai_gen_id }} svg {
  width: 16px;
  height: 16px;
  stroke: #1a1a1a;
  stroke-width: 1.5;
  fill: none;
}

/* ── GRID LAYOUT ── */
.ai-popup-banner__grid-{{ ai_gen_id }} {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
}
@media (min-width: 768px) {
  .ai-popup-banner__grid-{{ ai_gen_id }} {
    flex-direction: row;
    min-height: 0;
  }
}

/* ── CAROUSEL COLUMN ── */
.ai-popup-banner__carousel-column-{{ ai_gen_id }} {
  position: relative;
  width: 100%;
  overflow: hidden;
  flex-shrink: 0;
}
@media (min-width: 768px) {
  .ai-popup-banner__carousel-column-{{ ai_gen_id }} {
    width: 50%;
    flex-shrink: 0;
  }
}
.ai-popup-banner__carousel-wrapper-{{ ai_gen_id }} {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 3;
  overflow: hidden;
  background-color: #faf8f5;
}
@media (min-width: 768px) {
  .ai-popup-banner__carousel-wrapper-{{ ai_gen_id }} {
    aspect-ratio: unset;
    height: 100%;
  }
}
.ai-popup-banner__carousel-track-{{ ai_gen_id }} {
  position: relative;
  width: 100%;
  height: 100%;
}
.ai-popup-banner__carousel-slide-{{ ai_gen_id }} {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  transition: opacity {{ block.settings.transition_duration }}ms ease-in-out;
  pointer-events: none;
}
.ai-popup-banner__carousel-slide-{{ ai_gen_id }}.active {
  opacity: 1;
  pointer-events: auto;
}
.ai-popup-banner__carousel-slide-{{ ai_gen_id }} img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.ai-popup-banner__carousel-placeholder-{{ ai_gen_id }} {
  width: 100%;
  height: 100%;
  background-color: #faf8f5;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ai-popup-banner__carousel-placeholder-{{ ai_gen_id }} svg {
  width: 100%;
  height: 100%;
  max-width: 400px;
  max-height: 400px;
}

/* Carousel play/pause control */
.ai-popup-banner__control-{{ ai_gen_id }} {
  position: absolute;
  bottom: {{ block.settings.control_position_bottom }}px;
  left: {{ block.settings.control_position_left }}px;
  width: {{ block.settings.control_size }}px;
  height: {{ block.settings.control_size }}px;
  background-color: rgba(255, 255, 255, 0.85);
  border: 1px solid rgba(183, 155, 111, 0.2);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  transition: all 0.3s ease;
}
.ai-popup-banner__control-{{ ai_gen_id }}:hover {
  background-color: #ffffff;
  border-color: rgba(183, 155, 111, 0.4);
}
.ai-popup-banner__control-icon-{{ ai_gen_id }} {
  width: 40%;
  height: 40%;
  fill: #1a1a1a;
}

/* ── TEXT COLUMN ── */
.ai-popup-banner__text-column-{{ ai_gen_id }} {
  background-color: {{ block.settings.background_color }};
  padding: 32px 28px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  position: relative;
}
@media (min-width: 768px) {
  .ai-popup-banner__text-column-{{ ai_gen_id }} {
    width: 50%;
    flex-shrink: 1;
    padding: 50px 40px;
    overflow-y: auto;
  }
}
.ai-popup-banner__text-content-{{ ai_gen_id }} {
  max-width: 100%;
  text-align: center;
}

/* Gold decorative line above text */
.ai-popup-banner__accent-{{ ai_gen_id }} {
  width: 45px;
  height: 1px;
  background: linear-gradient(90deg, transparent, #b79b6f, transparent);
  margin: 0 auto 22px auto;
}

/* Eyebrow / tag */
.ai-popup-banner__pill-{{ ai_gen_id }} {
  display: inline-block;
  background-color: transparent;
  color: #b79b6f;
  padding: 0;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 4px;
  font-weight: 500;
  margin-bottom: 18px;
  border: none;
  font-family: "Georgia", "Times New Roman", serif;
}

/* Headline */
.ai-popup-banner__headline-{{ ai_gen_id }} {
  font-size: clamp(22px, 5vw, {{ block.settings.headline_font_size_mobile }}px);
  line-height: {{ block.settings.headline_line_height }};
  color: #1a1a1a;
  font-weight: 300;
  margin: 0 0 14px 0;
  letter-spacing: 2px;
  text-align: center;
  text-transform: uppercase;
  font-family: "Georgia", "Times New Roman", serif;
}

/* Subtext */
.ai-popup-banner__subtext-{{ ai_gen_id }} {
  font-size: {{ block.settings.subtext_font_size }}px;
  color: #888888;
  margin: 0 0 28px 0;
  font-weight: 300;
  line-height: 1.6;
  letter-spacing: 1px;
  text-transform: uppercase;
  font-size: 11px;
}
.ai-popup-banner__subtext-{{ ai_gen_id }} a {
  text-decoration: none;
  color: #b79b6f;
  border-bottom: 1px solid rgba(183, 155, 111, 0.3);
  transition: border-color 0.3s ease;
}
.ai-popup-banner__subtext-{{ ai_gen_id }} a:hover {
  border-color: #b79b6f;
}

/* CTA button — elegant bordered */
.ai-popup-banner__cta-{{ ai_gen_id }} {
  display: inline-block;
  font-size: 11px;
  color: #1a1a1a;
  background-color: transparent;
  text-decoration: none;
  text-transform: uppercase;
  letter-spacing: 3px;
  font-weight: 400;
  padding: 14px 40px;
  border: 1px solid rgba(183, 155, 111, 0.4);
  transition: all 0.4s ease;
  font-family: "Georgia", "Times New Roman", serif;
}
.ai-popup-banner__cta-{{ ai_gen_id }}:hover {
  background-color: #1a1a1a;
  color: #ffffff;
  border-color: #1a1a1a;
}

/* Bottom decorative line */
.ai-popup-banner__bottom-accent-{{ ai_gen_id }} {
  width: 30px;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(183, 155, 111, 0.4), transparent);
  margin: 24px auto 0 auto;
}

/* Corner accents on text panel */
.ai-popup-banner__text-column-{{ ai_gen_id }}::before,
.ai-popup-banner__text-column-{{ ai_gen_id }}::after {
  content: "";
  position: absolute;
  width: 30px;
  height: 30px;
  border: 1px solid rgba(183, 155, 111, 0.15);
  pointer-events: none;
}
.ai-popup-banner__text-column-{{ ai_gen_id }}::before {
  top: 16px;
  left: 16px;
  border-right: none;
  border-bottom: none;
}
.ai-popup-banner__text-column-{{ ai_gen_id }}::after {
  bottom: 16px;
  right: 16px;
  border-left: none;
  border-top: none;
}

@media (max-width: 767px) {
  .ai-popup-banner__text-column-{{ ai_gen_id }}::before,
  .ai-popup-banner__text-column-{{ ai_gen_id }}::after {
    width: 20px;
    height: 20px;
    top: 12px;
    left: 12px;
  }
  .ai-popup-banner__text-column-{{ ai_gen_id }}::after {
    top: auto;
    left: auto;
    bottom: 12px;
    right: 12px;
  }
}

{% endstyle %}

<popup-carousel-{{ ai_gen_id }}
  class="ai-popup-banner-overlay-{{ ai_gen_id }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-interval="{{ block.settings.autoplay_interval }}"
  data-pause-on-hover="{{ block.settings.pause_on_hover }}"
  data-popup-delay="{{ block.settings.popup_delay }}"
  data-reshow-interval="{{ block.settings.reshow_interval }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-popup-banner-{{ ai_gen_id }}">
    <button class="ai-popup-banner__close-{{ ai_gen_id }}" aria-label="Close popup" data-close>
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <line x1="6" y1="6" x2="18" y2="18"/>
        <line x1="18" y1="6" x2="6" y2="18"/>
      </svg>
    </button>

    <div class="ai-popup-banner__grid-{{ ai_gen_id }}">
      <div class="ai-popup-banner__carousel-column-{{ ai_gen_id }}">
        <div class="ai-popup-banner__carousel-wrapper-{{ ai_gen_id }}">
          <div class="ai-popup-banner__carousel-track-{{ ai_gen_id }}">
            {% if block.settings.image_1 != blank or block.settings.image_2 != blank or block.settings.image_3 != blank or block.settings.image_4 != blank or block.settings.image_5 != blank %}
              {% for i in (1..5) %}
                {% assign image_key = 'image_' | append: i %}
                {% assign image = block.settings[image_key] %}
                {% if image != blank %}
                  <div class="ai-popup-banner__carousel-slide-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}" data-slide="{{ forloop.index }}">
                    <img
                      src="{{ image | image_url: width: 1400 }}"
                      alt="{{ image.alt | escape }}"
                      loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                      width="{{ image.width }}"
                      height="{{ image.height }}"
                    >
                  </div>
                {% endif %}
              {% endfor %}
            {% else %}
              <div class="ai-popup-banner__carousel-slide-{{ ai_gen_id }} active" data-slide="1">
                <div class="ai-popup-banner__carousel-placeholder-{{ ai_gen_id }}">
                  {{ 'hero-apparel-1' | placeholder_svg_tag }}
                </div>
              </div>
            {% endif %}
          </div>

          {% if block.settings.show_controls %}
            <button
              class="ai-popup-banner__control-{{ ai_gen_id }}"
              aria-label="Toggle carousel playback"
              data-control
            >
              <svg class="ai-popup-banner__control-icon-{{ ai_gen_id }}" data-pause-icon viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <rect x="6" y="4" width="4" height="16" rx="1"/>
                <rect x="14" y="4" width="4" height="16" rx="1"/>
              </svg>
              <svg class="ai-popup-banner__control-icon-{{ ai_gen_id }}" data-play-icon style="display: none;" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </button>
          {% endif %}
        </div>
      </div>

      <div class="ai-popup-banner__text-column-{{ ai_gen_id }}">
        <div class="ai-popup-banner__text-content-{{ ai_gen_id }}">
          <div class="ai-popup-banner__accent-{{ ai_gen_id }}"></div>

          {% if block.settings.pill_text != blank %}
            <div class="ai-popup-banner__pill-{{ ai_gen_id }}">
              {{ block.settings.pill_text }}
            </div>
          {% endif %}

          {% if block.settings.headline != blank %}
            <h2 class="ai-popup-banner__headline-{{ ai_gen_id }}">
              {{ block.settings.headline }}
            </h2>
          {% endif %}

          {% if block.settings.subtext != blank %}
            <div class="ai-popup-banner__subtext-{{ ai_gen_id }}">
              {{ block.settings.subtext }}
            </div>
          {% endif %}

          {% if block.settings.cta_text != blank and block.settings.cta_link != blank %}
            <a href="{{ block.settings.cta_link }}" class="ai-popup-banner__cta-{{ ai_gen_id }}">
              {{ block.settings.cta_text }}
            </a>
          {% endif %}

          <div class="ai-popup-banner__bottom-accent-{{ ai_gen_id }}"></div>
        </div>
      </div>
    </div>
  </div>
</popup-carousel-{{ ai_gen_id }}>

<script>
(function() {
  var STORAGE_KEY = 'ai_popup_dismissed_{{ ai_gen_id }}';

  function storageGet(key) {
    try { return localStorage.getItem(key); } catch(e) { return null; }
  }
  function storageSet(key, val) {
    try { localStorage.setItem(key, val); } catch(e) { /* silent */ }
  }

  class PopupCarousel{{ ai_gen_id }} extends HTMLElement {
    constructor() {
      super();
      this.currentSlide = 0;
      this.isPermanentlyPaused = false;
      this.intervalId = null;
      this.reshowTimerId = null;
      this.slides = [];
      this._initialized = false;
    }

    connectedCallback() {
      if (this._initialized) return;
      this._initialized = true;
      this.init();
    }

    init() {
      this.slides = Array.from(this.querySelectorAll('.ai-popup-banner__carousel-slide-{{ ai_gen_id }}'));
      this.controlButton = this.querySelector('[data-control]');
      this.pauseIcon = this.querySelector('[data-pause-icon]');
      this.playIcon = this.querySelector('[data-play-icon]');
      this.closeButton = this.querySelector('[data-close]');
      this.autoplay = this.dataset.autoplay === 'true';
      this.interval = parseInt(this.dataset.interval) || 4000;
      this.pauseOnHover = this.dataset.pauseOnHover === 'true';
      this.popupDelay = parseInt(this.dataset.popupDelay) || 1500;
      this.reshowInterval = (parseInt(this.dataset.reshowInterval) || 3) * 60000;

      if (!this.closeButton || !this.slides.length) return;

      this.setupCloseListeners();

      if (this.slides.length > 1) {
        this.setupCarouselListeners();
      } else if (this.controlButton) {
        this.controlButton.style.display = 'none';
      }

      var lastDismissed = parseInt(storageGet(STORAGE_KEY), 10);
      var now = Date.now();

      if (lastDismissed && (now - lastDismissed < this.reshowInterval)) {
        var remaining = this.reshowInterval - (now - lastDismissed);
        this.scheduleReshow(remaining);
        return;
      }

      this.showPopup();
    }

    setupCloseListeners() {
      var self = this;
      this.closeButton.addEventListener('click', function() {
        self.closePopup();
      });
      this.addEventListener('click', function(e) {
        if (e.target === self) {
          self.closePopup();
        }
      });
    }

    showPopup() {
      var self = this;
      setTimeout(function() {
        self.classList.add('is-visible');
        document.body.style.overflow = 'hidden';
        if (self.slides.length > 1 && self.autoplay) {
          self.startAutoplay();
        }
      }, this.popupDelay);
    }

    scheduleReshow(delay) {
      var self = this;
      if (this.reshowTimerId) clearTimeout(this.reshowTimerId);
      this.reshowTimerId = setTimeout(function() {
        self.currentSlide = 0;
        self.slides.forEach(function(s, i) {
          s.classList.toggle('active', i === 0);
        });
        self.showPopup();
      }, delay);
    }

    closePopup() {
      var self = this;
      this.classList.add('is-closing');
      this.clearAutoplay();
      storageSet(STORAGE_KEY, String(Date.now()));
      setTimeout(function() {
        self.classList.remove('is-visible', 'is-closing');
        document.body.style.overflow = '';
        self.scheduleReshow(self.reshowInterval);
      }, 700);
    }

    setupCarouselListeners() {
      if (this.controlButton) {
        this.controlButton.addEventListener('click', this.togglePlayPause.bind(this));
      }
      if (this.pauseOnHover) {
        var wrapper = this.querySelector('.ai-popup-banner__carousel-wrapper-{{ ai_gen_id }}');
        if (wrapper) {
          wrapper.addEventListener('mouseenter', function() {
            if (!this.isPermanentlyPaused) this.clearAutoplay();
          }.bind(this));
          wrapper.addEventListener('mouseleave', function() {
            if (!this.isPermanentlyPaused && this.autoplay) this.startAutoplay();
          }.bind(this));
        }
      }
    }

    startAutoplay() {
      this.clearAutoplay();
      this.intervalId = setInterval(this.nextSlide.bind(this), this.interval);
    }

    clearAutoplay() {
      if (this.intervalId) {
        clearInterval(this.intervalId);
        this.intervalId = null;
      }
    }

    nextSlide() {
      this.slides[this.currentSlide].classList.remove('active');
      this.currentSlide = (this.currentSlide + 1) % this.slides.length;
      this.slides[this.currentSlide].classList.add('active');
    }

    togglePlayPause() {
      if (!this.isPermanentlyPaused) {
        this.manualPause();
      } else {
        this.manualPlay();
      }
    }

    manualPause() {
      this.isPermanentlyPaused = true;
      this.clearAutoplay();
      this.updateControlIcons(false);
    }

    manualPlay() {
      this.isPermanentlyPaused = false;
      this.startAutoplay();
      this.updateControlIcons(true);
    }

    updateControlIcons(playing) {
      if (this.pauseIcon && this.playIcon) {
        this.pauseIcon.style.display = playing ? 'block' : 'none';
        this.playIcon.style.display = playing ? 'none' : 'block';
      }
    }

    disconnectedCallback() {
      this.clearAutoplay();
      if (this.reshowTimerId) clearTimeout(this.reshowTimerId);
    }
  }

  if (!customElements.get('popup-carousel-{{ ai_gen_id }}')) {
    customElements.define('popup-carousel-{{ ai_gen_id }}', PopupCarousel{{ ai_gen_id }});
  }

  function fallbackInit() {
    var el = document.querySelector('popup-carousel-{{ ai_gen_id }}');
    if (el && !el._initialized) {
      el._initialized = true;
      el.init();
    }
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', fallbackInit);
  } else {
    setTimeout(fallbackInit, 0);
  }
})();
</script>

{% schema %}
{
  "name": "Popup banner carousel",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Popup"
    },
    {
      "type": "range",
      "id": "popup_delay",
      "min": 0,
      "max": 5000,
      "step": 500,
      "unit": "ms",
      "label": "Popup delay",
      "default": 1500
    },
    {
      "type": "range",
      "id": "reshow_interval",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "min",
      "label": "Reshow after (minutes)",
      "default": 3
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Carousel images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Image 4"
    },
    {
      "type": "image_picker",
      "id": "image_5",
      "label": "Image 5"
    },
    {
      "type": "header",
      "content": "Carousel behavior"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "min": 2000,
      "max": 8000,
      "step": 500,
      "unit": "ms",
      "label": "Autoplay interval",
      "default": 4000
    },
    {
      "type": "range",
      "id": "transition_duration",
      "min": 300,
      "max": 1000,
      "step": 100,
      "unit": "ms",
      "label": "Transition duration",
      "default": 700
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Carousel controls"
    },
    {
      "type": "checkbox",
