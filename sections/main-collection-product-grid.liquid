{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
{%- endunless -%}
{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- if section.settings.quick_add == 'bulk' -%}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  span.page,
  span.next,
  span.prev,
  span.deco {
    display: none !important;
  }

  /* ── Enhanced Product Titles and Prices ── */
  .section-{{ section.id }}-padding .card__heading,
  .section-{{ section.id }}-padding .card__heading a,
  .section-{{ section.id }}-padding .card-information__text,
  .section-{{ section.id }}-padding .card-information__text a {
    color: #3c2415 !important;
  }

  .section-{{ section.id }}-padding .price-item,
  .section-{{ section.id }}-padding .price-item--regular,
  .section-{{ section.id }}-padding .price-item--sale,
  .section-{{ section.id }}-padding .price-item--last,
  .section-{{ section.id }}-padding .price .money {
    color: rgb(0, 0, 0) !important;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0.05rem;
  }

  .section-{{ section.id }}-padding .price-item--regular {
    font-weight: 400;
    opacity: 0.8;
  }

  /* ── Luxury BOGO Announcement Banner ── */
  .collection-promo-banner {
    position: relative;
    overflow: hidden;
    margin: 0 auto 32px;
    padding: 28px 24px;
    max-width: 1200px;
    border: 1px solid rgba(183, 155, 111, 0.35);
    border-radius: 2px;
    background: linear-gradient(135deg, #1a1a1a 0%, #2c2424 50%, #1a1a1a 100%);
    text-align: center;
    color: #f5f0eb;
  }

  .collection-promo-banner::before,
  .collection-promo-banner::after {
    content: '';
    position: absolute;
    top: 0;
    width: 120px;
    height: 100%;
    pointer-events: none;
    opacity: 0.10;
    background: linear-gradient(180deg, transparent 0%, #b79b6f 50%, transparent 100%);
  }

  .collection-promo-banner::before { left: 0; }
  .collection-promo-banner::after  { right: 0; }

  .promo-banner__rule {
    display: block;
    width: 60px;
    height: 1px;
    margin: 0 auto 14px;
    border: none;
    background: linear-gradient(90deg, transparent, #b79b6f, transparent);
  }

  .promo-banner__eyebrow {
    margin: 0 0 6px;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 3.5px;
    text-transform: uppercase;
    color: #b79b6f;
  }

  .promo-banner__headline {
    margin: 0 0 6px;
    font-size: clamp(20px, 3vw, 30px);
    font-weight: 300;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    line-height: 1.25;
    color: #f5f0eb;
  }

  .promo-banner__headline em {
    font-style: normal;
    color: #b79b6f;
  }

  .promo-banner__sub {
    margin: 0 0 4px;
    font-size: 13px;
    font-weight: 300;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: rgba(245, 240, 235, 0.7);
  }

  .promo-banner__rule--bottom {
    margin: 14px auto 0;
  }

  .promo-banner__shimmer {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(183, 155, 111, 0.04) 40%,
      rgba(183, 155, 111, 0.08) 50%,
      rgba(183, 155, 111, 0.04) 60%,
      transparent 100%
    );
    animation: promoShimmer 6s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes promoShimmer {
    0%   { left: -100%; }
    50%  { left: 100%; }
    100% { left: 100%; }
  }

  @media screen and (max-width: 749px) {
    .collection-promo-banner {
      margin: 0 16px 24px;
      padding: 22px 18px;
    }
  }

  /* ── Collection Image CTA Banners ── */
  .collection-image-cta {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    overflow: hidden;
    margin: 48px 0;
    min-height: 420px;
    border-radius: 2px;
    background: #f8f6f3;
  }

  .collection-image-cta--reverse {
    direction: rtl;
  }

  .collection-image-cta--reverse > * {
    direction: ltr;
  }

  .collection-image-cta__media {
    position: relative;
    overflow: hidden;
    min-height: 420px;
  }

  .collection-image-cta__media img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .collection-image-cta:hover .collection-image-cta__media img {
    transform: scale(1.03);
  }

  .collection-image-cta__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 48px 56px;
    background: linear-gradient(135deg, #1a1a1a 0%, #2c2424 50%, #1a1a1a 100%);
    position: relative;
    overflow: hidden;
  }

  .collection-image-cta__content::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      135deg,
      rgba(183, 155, 111, 0.03) 0%,
      transparent 50%,
      rgba(183, 155, 111, 0.03) 100%
    );
    pointer-events: none;
  }

  .collection-image-cta__rule {
    display: block;
    width: 40px;
    height: 1px;
    margin: 0 0 20px;
    border: none;
    background: linear-gradient(90deg, #b79b6f, transparent);
  }

  .collection-image-cta__eyebrow {
    margin: 0 0 10px;
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: #b79b6f;
  }

  .collection-image-cta__heading {
    margin: 0 0 16px;
    font-size: clamp(22px, 2.5vw, 32px);
    font-weight: 300;
    letter-spacing: 1px;
    line-height: 1.3;
    color: #f5f0eb;
    text-transform: uppercase;
  }

  .collection-image-cta__body {
    margin: 0 0 28px;
    font-size: 14px;
    font-weight: 300;
    line-height: 1.7;
    letter-spacing: 0.3px;
    color: rgba(245, 240, 235, 0.7);
  }

  .collection-image-cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 32px;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 3px;
    text-transform: uppercase;
    text-decoration: none;
    color: #f5f0eb;
    border: 1px solid rgba(183, 155, 111, 0.4);
    border-radius: 0;
    background: transparent;
    transition: all 0.4s ease;
    align-self: flex-start;
  }

  .collection-image-cta__btn:hover {
    background: rgba(183, 155, 111, 0.12);
    border-color: #b79b6f;
    color: #b79b6f;
  }

  .collection-image-cta__btn svg {
    width: 14px;
    height: 14px;
    transition: transform 0.3s ease;
  }

  .collection-image-cta__btn:hover svg {
    transform: translateX(3px);
  }

  .collection-image-cta__shimmer {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(183, 155, 111, 0.03) 40%,
      rgba(183, 155, 111, 0.06) 50%,
      rgba(183, 155, 111, 0.03) 60%,
      transparent 100%
    );
    animation: ctaShimmer 8s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes ctaShimmer {
    0%   { left: -100%; }
    50%  { left: 100%; }
    100% { left: 100%; }
  }

  @media screen and (max-width: 749px) {
    .collection-image-cta {
      grid-template-columns: 1fr;
      margin: 32px 0;
      min-height: auto;
    }

    .collection-image-cta--reverse {
      direction: ltr;
    }

    .collection-image-cta__media {
      min-height: 280px;
      order: -1;
    }

    .collection-image-cta__content {
      padding: 32px 24px;
    }
  }
{%- endstyle -%}

{%- comment -%}
  Gather image CTA blocks and figure out which collections they target.
  Each block has a `target_collection` handle — only render on that collection page.
{%- endcomment -%}
{%- assign cta_blocks = section.blocks | where: 'type', 'collection_image_cta' -%}
{%- assign matching_ctas = '' -%}
{%- for block in cta_blocks -%}
  {%- if block.settings.target_collection == blank or block.settings.target_collection == collection.handle -%}
    {%- if matching_ctas == '' -%}
      {%- assign matching_ctas = block.id -%}
    {%- else -%}
      {%- assign matching_ctas = matching_ctas | append: ',' | append: block.id -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- assign matching_cta_ids = matching_ctas | split: ',' -%}

<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
  {%- paginate collection.products by section.settings.products_per_page -%}

    {%- comment -%} ── Luxury BOGO Announcement ── {%- endcomment -%}
    {% if section.settings.show_promo_banner %}
      <div class="collection-promo-banner" role="marquee" aria-label="Promotion">
        <span class="promo-banner__shimmer" aria-hidden="true"></span>
        <hr class="promo-banner__rule" aria-hidden="true">
        <p class="promo-banner__eyebrow">{{ section.settings.promo_eyebrow }}</p>
        <h2 class="promo-banner__headline">{{ section.settings.promo_headline }}</h2>
        <p class="promo-banner__sub">{{ section.settings.promo_subtext }}</p>
        <hr class="promo-banner__rule promo-banner__rule--bottom" aria-hidden="true">
      </div>
    {% endif %}

    {% comment %} Sort is the first tabbable element when filter type is vertical {% endcomment %}
    {%- if section.settings.enable_sorting and section.settings.filter_type == 'vertical' -%}
      <facet-filters-form class="facets facets-vertical-sort page-width small-hide">
        <form class="facets-vertical-form" id="FacetSortForm">
          <div class="facet-filters sorting caption">
            <div class="facet-filters__field">
              <h2 class="facet-filters__label caption-large text-body">
                <label for="SortBy">{{ 'products.facets.sort_by_label' | t }}</label>
              </h2>
              <div class="select">
                {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
                <select
                  name="sort_by"
                  class="facet-filters__sort select__select caption-large"
                  id="SortBy"
                  aria-describedby="a11y-refresh-page-message"
                >
                  {%- for option in collection.sort_options -%}
                    <option
                      value="{{ option.value | escape }}"
                      {% if option.value == sort_by %}
                        selected="selected"
                      {% endif %}
                    >
                      {{ option.name | escape }}
                    </option>
                  {%- endfor -%}
                </select>
                <span class="svg-wrapper">
                  {{- 'icon-caret.svg' | inline_asset_content -}}
                </span>
              </div>
            </div>
          </div>
          <div class="product-count-vertical light" role="status">
            <h2 class="product-count__text text-body">
              <span id="ProductCountDesktop">
                {%- if collection.results_count -%}
                  {{
                    'templates.search.results_with_count'
                    | t: terms: collection.terms, count: collection.results_count
                  }}
                {%- elsif collection.products_count == collection.all_products_count -%}
                  {{ 'products.facets.product_count_simple' | t: count: collection.products_count }}
                {%- else -%}
                  {{
                    'products.facets.product_count'
                    | t: product_count: collection.products_count, count: collection.all_products_count
                  }}
                {%- endif -%}
              </span>
            </h2>
            {%- render 'loading-spinner' -%}
          </div>
        </form>
      </facet-filters-form>
    {%- endif -%}

    <div
      class="{% if section.settings.filter_type == 'vertical' %} facets-vertical page-width{% endif %}"
    >
      {{ 'component-facets.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
      {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
        <aside
          aria-labelledby="verticalTitle"
          class="facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
          id="main-collection-filters"
          data-id="{{ section.id }}"
        >
          {% render 'facets',
            results: collection,
            enable_filtering: section.settings.enable_filtering,
            enable_sorting: section.settings.enable_sorting,
            filter_type: section.settings.filter_type,
            paginate: paginate
          %}
        </aside>
      {%- endif -%}

      <div
        class="product-grid-container{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        id="ProductGridContainer"
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
        {% endif %}
      >
        {%- if collection.products.size == 0 -%}
          <div
            class="collection collection--empty page-width"
            id="product-grid"
            data-id="{{ section.id }}"
          >
            <div class="loading-overlay gradient"></div>
            <div class="title-wrapper center">
              <h2 class="title title--primary">
                {{ 'sections.collection_template.empty' | t -}}
                <br>
                {{
                  'sections.collection_template.use_fewer_filters_html'
                  | t: link: collection.url, class: 'underlined-link link'
                }}
              </h2>
            </div>
          </div>
        {%- else -%}
          <div
            class="collection{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
          >
            <div class="loading-overlay gradient"></div>
            <ul
              id="product-grid"
              data-id="{{ section.id }}"
              class="
                grid product-grid
                grid--{{ section.settings.columns_mobile }}-col-tablet-down
                grid--{{ section.settings.columns_desktop }}-col-desktop
                {% if section.settings.quick_add == 'bulk' %} collection-quick-add-bulk{% endif %}
              "
            >
              {% assign skip_card_product_styles = false %}
              {%- assign cta_insert_index = 0 -%}
              {%- assign products_per_row = section.settings.columns_desktop -%}
              {%- assign cta_interval = products_per_row | times: 2 -%}

              {%- for product in collection.products -%}
                {% assign lazy_load = false %}
                {%- if forloop.index > 2 -%}
                  {%- assign lazy_load = true -%}
                {%- endif -%}

                <li
                  class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  {% render 'card-product',
                    card_product: product,
                    media_aspect_ratio: section.settings.image_ratio,
                    image_shape: section.settings.image_shape,
                    show_secondary_image: section.settings.show_secondary_image,
                    show_vendor: section.settings.show_vendor,
                    show_rating: section.settings.show_rating,
                    lazy_load: lazy_load,
                    skip_styles: skip_card_product_styles,
                    quick_add: section.settings.quick_add,
                    section_id: section.id
                  %}
                </li>
                {%- assign skip_card_product_styles = true -%}

                {%- comment -%}
                  Insert a collection image CTA after every 2 rows of products.
                  Only show CTAs that match the current collection handle.
                  Alternates: even index = image left / CTA right, odd = reversed.
                {%- endcomment -%}
                {%- assign position_check = forloop.index | modulo: cta_interval -%}
                {%- if position_check == 0 and matching_cta_ids.size > 0 -%}
                  {%- if cta_insert_index < matching_cta_ids.size -%}
                    {%- assign current_cta_id = matching_cta_ids[cta_insert_index] -%}
                    {%- for block in cta_blocks -%}
                      {%- if block.id == current_cta_id -%}
                        {%- assign is_reversed = cta_insert_index | modulo: 2 -%}
                        </ul>

                        <div
                          class="collection-image-cta{% if is_reversed == 1 %} collection-image-cta--reverse{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                          {{ block.shopify_attributes }}
                        >
                          <div class="collection-image-cta__media">
                            {%- if block.settings.image != blank -%}
                              {{
                                block.settings.image
                                | image_url: width: 960
                                | image_tag:
                                  loading: 'lazy',
                                  widths: '375, 550, 750, 960',
                                  sizes: '(max-width: 749px) 100vw, 50vw'
                              }}
                            {%- else -%}
                              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                            {%- endif -%}
                          </div>
                          <div class="collection-image-cta__content">
                            <span class="collection-image-cta__shimmer" aria-hidden="true"></span>
                            <hr class="collection-image-cta__rule" aria-hidden="true">
                            {%- if block.settings.eyebrow != blank -%}
                              <p class="collection-image-cta__eyebrow">{{ block.settings.eyebrow }}</p>
                            {%- endif -%}
                            {%- if block.settings.heading != blank -%}
                              <h3 class="collection-image-cta__heading">{{ block.settings.heading }}</h3>
                            {%- endif -%}
                            {%- if block.settings.body_text != blank -%}
                              <p class="collection-image-cta__body">{{ block.settings.body_text }}</p>
                            {%- endif -%}
                            {%- if block.settings.button_label != blank -%}
                              <a
                                href="{{ block.settings.button_link | default: '#' }}"
                                class="collection-image-cta__btn"
                              >
                                {{ block.settings.button_label }}
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                  <line x1="5" y1="12" x2="19" y2="12"></line>
                                  <polyline points="12 5 19 12 12 19"></polyline>
                                </svg>
                              </a>
                            {%- endif -%}
                          </div>
                        </div>

                        <ul
                          id="product-grid"
                          data-id="{{ section.id }}"
                          class="
                            grid product-grid
                            grid--{{ section.settings.columns_mobile }}-col-tablet-down
                            grid--{{ section.settings.columns_desktop }}-col-desktop
                            {% if section.settings.quick_add == 'bulk' %} collection-quick-add-bulk{% endif %}
                          "
                        >
                      {%- endif -%}
                    {%- endfor -%}
                    {%- assign cta_insert_index = cta_insert_index | plus: 1 -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            </ul>

            {%- if paginate.pages > 1 -%}
              {% render 'pagination', paginate: paginate, anchor: '' %}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endpaginate -%}

  {% if section.settings.image_shape == 'arch' %}
    {{ 'mask-arch.svg' | inline_asset_content }}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.main-collection-product-grid.name",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Promotion Banner"
    },
    {
      "type": "checkbox",
      "id": "show_promo_banner",
      "default": true,
      "label": "Show promotion banner"
    },
    {
      "type": "text",
      "id": "promo_eyebrow",
      "default": "Limited Time · Exclusive Offer",
      "label": "Eyebrow text"
    },
    {
      "type": "text",
      "id": "promo_headline",
      "default": "Mix & Match — Buy One, Get One <em>50% Off</em>",
      "label": "Headline (use <em> for gold accent)"
    },
    {
      "type": "text",
      "id": "promo_subtext",
      "default": "Pair your favourites · applied at checkout",
      "label": "Subtext"
    },
    {
      "type": "header",
      "content": "Product Grid"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 16,
      "label": "t:sections.main-collection-product-grid.settings.products_per_page.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "t:sections.main-collection-product-grid.settings.columns_desktop.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__3.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__3.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.main-collection-product-grid.settings.image_ratio.label"
    },
    {
      "type": "select",
      "id": "image_shape",
      "options": [
        {
          "value": "default",
          "label": "t:sections.all.image_shape.options__1.label"
        },
        {
