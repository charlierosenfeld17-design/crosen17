{% doc %}
  @prompt
    3 luxury circle icons for trust/checkout — sits in a row on desktop and mobile, with elegant text underneath. Fully customizable colors, fonts, and section background.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-icon-row-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 60px 20px;
    background-color: {{ block.settings.section_bg_color }};
  }
  .ai-icon-row-container-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 60px;
    max-width: 960px;
    margin: 0 auto;
  }
  .ai-icon-row-item-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 260px;
    opacity: 0;
    transform: translateY(16px);
    animation: aiFadeUp-{{ ai_gen_id }} 0.6s ease-out forwards;
  }
  .ai-icon-row-item-{{ ai_gen_id }}:nth-child(1) { animation-delay: 0.1s; }
  .ai-icon-row-item-{{ ai_gen_id }}:nth-child(2) { animation-delay: 0.25s; }
  .ai-icon-row-item-{{ ai_gen_id }}:nth-child(3) { animation-delay: 0.4s; }
  @keyframes aiFadeUp-{{ ai_gen_id }} {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .ai-icon-row-circle-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    flex-shrink: 0;
    position: relative;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .ai-icon-row-circle-{{ ai_gen_id }}:hover {
    transform: scale(1.06);
  }
  .ai-icon-row-circle-1-{{ ai_gen_id }} {
    background-color: {{ block.settings.icon_1_bg_color }};
    box-shadow: 0 0 0 1px {{ block.settings.icon_1_border_color }}, 0 4px 20px rgba(0,0,0,0.08);
  }
  .ai-icon-row-circle-1-{{ ai_gen_id }}:hover {
    box-shadow: 0 0 0 1px {{ block.settings.icon_1_border_color }}, 0 8px 30px rgba(0,0,0,0.12);
  }
  .ai-icon-row-circle-2-{{ ai_gen_id }} {
    background-color: {{ block.settings.icon_2_bg_color }};
    box-shadow: 0 0 0 1px {{ block.settings.icon_2_border_color }}, 0 4px 20px rgba(0,0,0,0.08);
  }
  .ai-icon-row-circle-2-{{ ai_gen_id }}:hover {
    box-shadow: 0 0 0 1px {{ block.settings.icon_2_border_color }}, 0 8px 30px rgba(0,0,0,0.12);
  }
  .ai-icon-row-circle-3-{{ ai_gen_id }} {
    background-color: {{ block.settings.icon_3_bg_color }};
    box-shadow: 0 0 0 1px {{ block.settings.icon_3_border_color }}, 0 4px 20px rgba(0,0,0,0.08);
  }
  .ai-icon-row-circle-3-{{ ai_gen_id }}:hover {
    box-shadow: 0 0 0 1px {{ block.settings.icon_3_border_color }}, 0 8px 30px rgba(0,0,0,0.12);
  }
  .ai-icon-row-icon-{{ ai_gen_id }} {
    width: calc({{ block.settings.icon_size }}px * 0.42);
    height: calc({{ block.settings.icon_size }}px * 0.42);
  }
  .ai-icon-row-icon-1-{{ ai_gen_id }} {
    color: {{ block.settings.icon_1_color }};
  }
  .ai-icon-row-icon-2-{{ ai_gen_id }} {
    color: {{ block.settings.icon_2_color }};
  }
  .ai-icon-row-icon-3-{{ ai_gen_id }} {
    color: {{ block.settings.icon_3_color }};
  }
  .ai-icon-row-text-{{ ai_gen_id }} {
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
    letter-spacing: 0.04em;
  }
  .ai-icon-row-text-1-{{ ai_gen_id }} {
    color: {{ block.settings.text_1_color }};
  }
  .ai-icon-row-text-2-{{ ai_gen_id }} {
    color: {{ block.settings.text_2_color }};
  }
  .ai-icon-row-text-3-{{ ai_gen_id }} {
    color: {{ block.settings.text_3_color }};
  }
  .ai-icon-row-divider-{{ ai_gen_id }} {
    width: 1px;
    height: 80px;
    background: {{ block.settings.divider_color }};
    align-self: center;
    flex-shrink: 0;
  }
  @media screen and (max-width: 749px) {
    .ai-icon-row-{{ ai_gen_id }} {
      padding: 40px 16px;
    }
    .ai-icon-row-container-{{ ai_gen_id }} {
      gap: 24px;
    }
    .ai-icon-row-circle-{{ ai_gen_id }} {
      width: calc({{ block.settings.icon_size }}px * 0.7);
      height: calc({{ block.settings.icon_size }}px * 0.7);
      margin-bottom: 14px;
    }
    .ai-icon-row-icon-{{ ai_gen_id }} {
      width: calc({{ block.settings.icon_size }}px * 0.32);
      height: calc({{ block.settings.icon_size }}px * 0.32);
    }
    .ai-icon-row-text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_size }}px * 0.85);
    }
    .ai-icon-row-divider-{{ ai_gen_id }} {
      height: 50px;
    }
  }
{% endstyle %}
<icon-row-{{ ai_gen_id }} class="ai-icon-row-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-icon-row-container-{{ ai_gen_id }}">
    <div class="ai-icon-row-item-{{ ai_gen_id }}">
      <div class="ai-icon-row-circle-{{ ai_gen_id }} ai-icon-row-circle-1-{{ ai_gen_id }}">
        <svg class="ai-icon-row-icon-{{ ai_gen_id }} ai-icon-row-icon-1-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
{% case block.settings.icon_1_type %}
{% when 'star' %}
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
{% when 'heart' %}
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
{% when 'check' %}
              <polyline points="20 6 9 17 4 12"></polyline>
{% when 'gift' %}
              <polyline points="20 12 20 22 4 22 4 12"></polyline>
              <rect x="2" y="7" width="20" height="5"></rect>
              <line x1="12" y1="22" x2="12" y2="7"></line>
              <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
              <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
{% when 'truck' %}
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
{% when 'shield' %}
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
{% when 'lock' %}
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
{% when 'diamond' %}
              <path d="M6 3h12l4 6-10 13L2 9z"></path>
              <path d="M2 9h20"></path>
              <path d="M10 3l-4 6 6 13 6-13-4-6"></path>
{% endcase %}
        </svg>
      </div>
{% if block.settings.text_1 != blank %}
        <div class="ai-icon-row-text-{{ ai_gen_id }} ai-icon-row-text-1-{{ ai_gen_id }}">
{{ block.settings.text_1 }}
        </div>
{% endif %}
    </div>
    <div class="ai-icon-row-divider-{{ ai_gen_id }}"></div>
    <div class="ai-icon-row-item-{{ ai_gen_id }}">
      <div class="ai-icon-row-circle-{{ ai_gen_id }} ai-icon-row-circle-2-{{ ai_gen_id }}">
        <svg class="ai-icon-row-icon-{{ ai_gen_id }} ai-icon-row-icon-2-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
