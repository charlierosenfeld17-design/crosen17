{% doc %}
  @prompt
    A horizontal set of three high-resolution luxury e-commerce icons  Ensure perfectly balanced weight across all three icons. Aesthetic: Quiet luxury, sophisticated, architectural, and premium. 8k resolution, clean edges, centered composition.", need subtext smaller under icon text, centered paragraph form, add another icon, need everything customazable, icon spacing, schemes, font sizes
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-luxury-icons-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 0;
    margin: 0;
    background: {{ block.settings.background_color }};
  }
  .ai-luxury-icons-gradient-{{ ai_gen_id }} {
    height: {{ block.settings.gradient_height }}px;
    background: linear-gradient(to bottom, {{ block.settings.background_color }}, {{ block.settings.gradient_end_color }});
  }
  .ai-luxury-icons-container-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-evenly;
    align-items: flex-start;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 0 20px;
  }
  .ai-luxury-icon-item-{{ ai_gen_id }} {
    flex: 0 1 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: {{ block.settings.text_spacing }}px;
    max-width: {{ block.settings.icon_max_width }}px;
  }
  .ai-luxury-icon-wrapper-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .ai-luxury-icon-svg-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    stroke: {{ block.settings.icon_color }};
    fill: none;
    stroke-width: {{ block.settings.stroke_weight }};
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ai-luxury-icon-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    text-align: center;
    letter-spacing: {{ block.settings.letter_spacing }}px;
    text-transform: {{ block.settings.text_transform }};
    font-weight: {{ block.settings.text_weight }};
    line-height: {{ block.settings.text_line_height }};
    margin: 0;
  }
  .ai-luxury-icon-subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_size }}px;
    color: {{ block.settings.subtext_color }};
    text-align: center;
    line-height: {{ block.settings.subtext_line_height }};
    margin: 0;
    padding: 0 {{ block.settings.subtext_padding }}px;
    font-weight: {{ block.settings.subtext_weight }};
  }
  @media screen and (max-width: 749px) {
    .ai-luxury-icons-container-{{ ai_gen_id }} {
      flex-direction: {{ block.settings.mobile_layout }};
      justify-content: center;
      gap: {{ block.settings.mobile_icon_spacing }}px;
      width: 100%;
    }
    .ai-luxury-icon-svg-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_icon_size }}px;
      height: {{ block.settings.mobile_icon_size }}px;
    }
    .ai-luxury-icon-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_text_size }}px;
    }
    .ai-luxury-icon-subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_subtext_size }}px;
    }
  }
{% endstyle %}
<luxury-icons-{{ ai_gen_id }} class="ai-luxury-icons-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-luxury-icons-container-{{ ai_gen_id }}" style="padding-bottom: {{ block.settings.section_padding_bottom }}px;">
    <div class="ai-luxury-icon-item-{{ ai_gen_id }}">
      <div class="ai-luxury-icon-wrapper-{{ ai_gen_id }}">
        <svg class="ai-luxury-icon-svg-{{ ai_gen_id }}" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
          <path d="M50 15 L50 85 M35 30 L50 15 L65 30 M20 50 L80 50 M20 70 L80 70" />
          <circle cx="50" cy="50" r="30" />
          <path d="M35 45 L50 30 L65 45" />
        </svg>
      </div>
{% if block.settings.icon_1_text != blank %}
        <div class="ai-luxury-icon-text-{{ ai_gen_id }}">{{ block.settings.icon_1_text }}</div>
{% endif %}
{% if block.settings.icon_1_subtext != blank %}
        <p class="ai-luxury-icon-subtext-{{ ai_gen_id }}">{{ block.settings.icon_1_subtext }}</p>
{% endif %}
    </div>
    <div class="ai-luxury-icon-item-{{ ai_gen_id }}">
      <div class="ai-luxury-icon-wrapper-{{ ai_gen_id }}">
        <svg class="ai-luxury-icon-svg-{{ ai_gen_id }}" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
          <rect x="25" y="35" width="50" height="40" rx="2" />
          <path d="M30 35 L30 30 Q30 20 40 20 L60 20 Q70 20 70 30 L70 35" />
          <circle cx="50" cy="55" r="5" />
          <path d="M35 50 L35 60 M65 50 L65 60" />
          <line x1="40" y1="45" x2="60" y2="45" />
        </svg>
      </div>
{% if block.settings.icon_2_text != blank %}
        <div class="ai-luxury-icon-text-{{ ai_gen_id }}">{{ block.settings.icon_2_text }}</div>
{% endif %}
{% if block.settings.icon_2_subtext != blank %}
        <p class="ai-luxury-icon-subtext-{{ ai_gen_id }}">{{ block.settings.icon_2_subtext }}</p>
{% endif %}
    </div>
    <div class="ai-luxury-icon-item-{{ ai_gen_id }}">
      <div class="ai-luxury-icon-wrapper-{{ ai_gen_id }}">
        <svg class="ai-luxury-icon-svg-{{ ai_gen_id }}" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
          <polygon points="50,20 65,40 80,45 65,60 70,80 50,70 30,80 35,60 20,45 35,40" />
          <circle cx="50" cy="50" r="12" />
          <path d="M50 38 L50 30 M50 70 L50 62 M38 50 L30 50 M70 50 L62 50" />
        </svg>
      </div>
{% if block.settings.icon_3_text != blank %}
        <div class="ai-luxury-icon-text-{{ ai_gen_id }}">{{ block.settings.icon_3_text }}</div>
{% endif %}
{% if block.settings.icon_3_subtext != blank %}
        <p class="ai-luxury-icon-subtext-{{ ai_gen_id }}">{{ block.settings.icon_3_subtext }}</p>
{% endif %}
    </div>
    <div class="ai-luxury-icon-item-{{ ai_gen_id }}">
      <div class="ai-luxury-icon-wrapper-{{ ai_gen_id }}">
        <svg class="ai-luxury-icon-svg-{{ ai_gen_id }}" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
          <circle cx="50" cy="50" r="35" />
          <path d="M50 20 L50 50 L70 60" />
          <circle cx="50" cy="50" r="3" />
          <path d="M30 30 L35 35 M70 30 L65 35 M70 70 L65 65 M30 70 L35 65" />
        </svg>
      </div>
{% if block.settings.icon_4_text != blank %}
        <div class="ai-luxury-icon-text-{{ ai_gen_id }}">{{ block.settings.icon_4_text }}</div>
{% endif %}
{% if block.settings.icon_4_subtext != blank %}
        <p class="ai-luxury-icon-subtext-{{ ai_gen_id }}">{{ block.settings.icon_4_subtext }}</p>
{% endif %}
    </div>
  </div>
  <div class="ai-luxury-icons-gradient-{{ ai_gen_id }}"></div>
</luxury-icons-{{ ai_gen_id }}>
<script>
  (function() {
    class LuxuryIcons{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
      connectedCallback() {
        this.style.display = 'block';
      }
    }
    customElements.define('luxury-icons-{{ ai_gen_id }}', LuxuryIcons{{ ai_gen_id }});
  })();
</script>
{% schema %}
