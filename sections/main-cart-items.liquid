{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    text-transform: uppercase;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* ── Luxury cart overrides ── */
  .cart-luxury__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    padding-bottom: 2rem;
    margin-bottom: 3rem;
    text-transform: uppercase;
    color: #000;
  }

  .cart-luxury__title {
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0 0 0.75rem;
    color: #000;
  }

  .cart-luxury__continue {
    font-size: 1.1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
    transition: opacity 0.3s ease;
    color: #B79A6E;
  }

  .cart-luxury__continue:hover {
    opacity: 0.6;
  }

  /* ── Empty cart ── */
  .cart-luxury__empty {
    text-align: center;
    padding: 6rem 0;
    text-transform: uppercase;
    color: #000;
  }

  .cart-luxury__empty-text {
    font-size: 1.4rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
    color: #000;
  }

  .cart-luxury__empty-cta {
    display: inline-block;
    padding: 1rem 3rem;
    font-size: 1rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid #000;
    transition: background-color 0.3s ease, color 0.3s ease;
    color: #000;
  }

  .cart-luxury__empty-cta:hover {
    background-color: #000;
    color: #B79A6E;
  }

  .cart-luxury__login {
    margin-top: 2.5rem;
    text-transform: uppercase;
    color: #000;
  }

  .cart-luxury__login h2 {
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    color: #000;
  }

  .cart-luxury__login p {
    font-size: 0.9rem;
    opacity: 0.7;
    text-transform: uppercase;
    color: #000;
  }

  /* ── Item list ── */
  .cart-luxury__items {
    list-style: none;
    margin: 0;
    padding: 0;
    text-transform: uppercase;
  }

  /* ── Single item card ── */
  .cart-luxury__item {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 1.5rem;
    padding: 2rem 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    align-items: center;
    text-transform: uppercase;
    color: #000;
  }

  .cart-luxury__item .cart-luxury__quantity-col {
    grid-column: 1 / -1;
    justify-self: end;
  }

  @media screen and (min-width: 750px) {
    .cart-luxury__item {
      grid-template-columns: 150px 1fr;
      gap: 2.5rem;
    }

    .cart-luxury__item .cart-luxury__quantity-col {
      grid-column: 2;
      justify-self: end;
    }
  }

  /* Image */
  .cart-luxury__image-wrap {
    position: relative;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.02);
  }

  .cart-luxury__image-wrap a {
    display: block;
  }

  .cart-luxury__image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  /* Details */
  .cart-luxury__details {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
    overflow: hidden;
    color: #000;
    text-transform: uppercase;
  }

  .cart-luxury__vendor {
    font-size: 1.3rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.5;
    margin: 0;
    color: #000;
  }

  .cart-luxury__product-name {
    font-size: 2rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: #B79A6E;
    margin: 0;
    transition: opacity 0.3s ease;
    word-wrap: break-word;
    overflow-wrap: break-word;
    text-transform: uppercase;
  }

  .cart-luxury__product-name:hover {
    opacity: 0.6;
  }

  .cart-luxury__variant-info {
    font-size: 1.4rem;
    opacity: 0.8;
    margin: 0;
    color: #000;
    text-transform: uppercase;
  }

  .cart-luxury__price-single {
    font-size: 1.4rem;
    margin: 0;
    color: #B79A6E;
    text-transform: uppercase;
  }

  .cart-luxury__price-single s {
    opacity: 0.5;
    margin-right: 0.5rem;
  }

  .cart-luxury__price-single strong {
    font-weight: 400;
    color: inherit;
  }

  .cart-luxury__selling-plan {
    font-size: 0.95rem;
    opacity: 0.5;
    margin: 0.25rem 0 0;
    text-transform: uppercase;
    color: #000;
  }

  .cart-luxury__discounts {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    text-transform: uppercase;
  }

  .cart-luxury__discount-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.95rem;
    padding: 0.25rem 0.6rem;
    background: rgba(0, 0, 0, 0.04);
    border-radius: 2px;
    text-transform: uppercase;
    color: #000;
  }

  .cart-luxury__discount-tag svg {
    width: 12px;
    height: 12px;
  }

  /* Quantity selector (centered) */
  .cart-luxury__quantity-col {
    display: flex;
    flex-direction: centered;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    text-transform: uppercase;
    color: #000;
  }


  .cart-luxury__quantity-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* Center the quantity number inside the input box */
  .cart-luxury__quantity-col .quantity__input {
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    -moz-appearance: textfield;
    text-transform: uppercase;
    color: #000;
  }

  .cart-luxury__quantity-col .quantity__input::-webkit-outer-spin-button,
  .cart-luxury__quantity-col .quantity__input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .cart-luxury__quantity-col .quantity {
    display: flex;
    align-items: center;
  }

  .cart-luxury__quantity-col .quantity__button {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #000;
  }

  .cart-luxury__remove a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    opacity: 0.4;
    transition: opacity 0.3s ease;
    color: #000;
    text-transform: uppercase;
  }

  /* Remove any blue link/button colors in cart */
  .cart-luxury__item a,
  .cart-luxury__item button,
  .cart-luxury__item .quantity__button,
  .cart-luxury__quantity-row a {
    color: #000;
  }

  .cart-luxury__remove a:hover {
    opacity: 1;
  }

  .cart-luxury__remove svg {
    width: 14px;
    height: 14px;
  }

  .cart-luxury__error {
    font-size: 0.75rem;
    color: rgb(var(--color-error, 200 50 50));
    text-align: right;
    margin-top: 0.25rem;
    text-transform: uppercase;
  }

  .cart-luxury__error svg {
    width: 12px;
    height: 12px;
    vertical-align: middle;
    margin-left: 0.25rem;
  }
{%- endstyle -%}

{%- unless settings.cart_type == 'drawer' -%}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>

<cart-items
  class="gradient color-{{ section.settings.color_scheme }} isolate{% if cart == empty %} is-empty{% else %} section-{{ section.id }}-padding{% endif %}"
>
  <div class="page-width">

    {%- comment -%} ── Header ── {%- endcomment -%}
    <div class="cart-luxury__header">
      <h1 class="cart-luxury__title">{{ 'sections.cart.title' | t | upcase }}</h1>
      <a href="{{ routes.all_products_collection_url }}" class="cart-luxury__continue color-scheme-7">
        {{- 'general.continue_shopping' | t | upcase -}}
      </a>
    </div>

    {%- comment -%} ── Empty state ── {%- endcomment -%}
    <div class="cart__warnings">
      <div class="cart-luxury__empty">
        <p class="cart-luxury__empty-text">{{ 'sections.cart.empty' | t | upcase }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="cart-luxury__empty-cta">
          {{ 'general.continue_shopping' | t | upcase }}
        </a>

        {%- if shop.customer_accounts_enabled and customer == null -%}
          <div class="cart-luxury__login">
            <h2>{{ 'sections.cart.login.title' | t | upcase }}</h2>
            <p>{{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url | upcase }}</p>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} ── Cart form ── {%- endcomment -%}
    <form action="{{ routes.cart_url }}" class="cart__contents critical-hidden" method="post" id="cart">
      <div class="cart__items" id="main-cart-items" data-id="{{ section.id }}">
        <div class="js-contents">
          {%- if cart != empty -%}
            <ul class="cart-luxury__items" role="list">
              {%- for item in cart.items -%}
                <li class="cart-luxury__item" id="CartItem-{{ item.index | plus: 1 }}">

                  {%- comment -%} ── Image ── {%- endcomment -%}
                  <div class="cart-luxury__image-wrap gradient global-media-settings">
                    {%- if item.image -%}
                      <a href="{{ item.url }}" aria-hidden="true" tabindex="-1">
                        <img
                          src="{{ item.image | image_url: width: 300 }}"
                          class="cart-luxury__image"
                          alt="{{ item.image.alt | escape | upcase }}"
                          loading="lazy"
                          width="150"
                          height="{{ 150 | divided_by: item.image.aspect_ratio | ceil }}"
                        >
                      </a>
                    {%- endif -%}
                  </div>

                  {%- comment -%} ── Product details ── {%- endcomment -%}
                  <div class="cart-luxury__details">
                    {%- if settings.show_vendor -%}
                      <p class="cart-luxury__vendor">{{ item.product.vendor | upcase }}</p>
                    {%- endif -%}

                    <a href="{{ item.url }}" class="cart-luxury__product-name">
                      {{ item.product.title | escape | upcase }}
                    </a>

                    {%- comment -%} Unit price ── {%- endcomment -%}
                    {%- if item.original_price != item.final_price -%}
                      <p class="cart-luxury__price-single">
                        <s>{{ item.original_price | money | upcase }}</s>
                        <strong>{{ item.final_price | money | upcase }}</strong>
                      </p>
                    {%- else -%}
                      <p class="cart-luxury__price-single">{{ item.original_price | money | upcase }}</p>
                    {%- endif -%}

                    {%- comment -%} Variants / properties ── {%- endcomment -%}
                    {%- if item.product.has_only_default_variant == false
                      or item.properties.size != 0
                      or item.selling_plan_allocation != null
                    -%}
                      {%- if item.product.has_only_default_variant == false -%}
                        {%- for option in item.options_with_values -%}
                          <p class="cart-luxury__variant-info">{{ option.name | upcase }}: {{ option.value | upcase }}</p>
                        {%- endfor -%}
                      {%- endif -%}

                      {%- for property in item.properties -%}
                        {%- assign property_first_char = property.first | slice: 0 -%}
                        {%- if property.last != blank and property_first_char != '_' -%}
                          <p class="cart-luxury__variant-info">
                            {{ property.first | upcase }}:
                            {%- if property.last contains '/uploads/' -%}
                              <a href="{{ property.last }}" class="link" target="_blank">
                                {{ property.last | split: '/' | last | upcase }}
                              </a>
                            {%- else -%}
                              {{ property.last | upcase }}
                            {%- endif -%}
                          </p>
                        {%- endif -%}
                      {%- endfor -%}

                      {%- if item.selling_plan_allocation -%}
                        <p class="cart-luxury__selling-plan">
                          {{ item.selling_plan_allocation.selling_plan.name | upcase }}
                        </p>
                      {%- endif -%}
                    {%- endif -%}

                    {%- comment -%} Line-level discounts ── {%- endcomment -%}
                    {%- if item.line_level_discount_allocations.size > 0 -%}
                      <ul class="cart-luxury__discounts" role="list" aria-label="{{ 'customer.order.discount' | t | upcase }}">
                        {%- for discount in item.line_level_discount_allocations -%}
                          <li class="cart-luxury__discount-tag">
                            {{- 'icon-discount.svg' | inline_asset_content -}}
                            {{ discount.discount_application.title | escape | upcase }}
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </div>

                  {%- comment -%} ── Quantity selector (centered column) ── {%- endcomment -%}
                  <div class="cart-luxury__quantity-col">
                    {%- liquid
                      assign has_qty_rules = false
                      if item.variant.quantity_rule.increment > 1 or item.variant.quantity_rule.min > 1 or item.variant.quantity_rule.max != null
                        assign has_qty_rules = true
                      endif
                      assign has_vol_pricing = false
                      if item.variant.quantity_price_breaks.size > 0
                        assign has_vol_pricing = true
                      endif
                    -%}

                    <quantity-popover>
                      <div class="cart-luxury__quantity-row quantity-popover-wrapper">
                        <label class="visually-hidden" for="Quantity-{{ item.index | plus: 1 }}">
                          {{ 'products.product.quantity.label' | t | upcase }}
                        </label>

                        <div class="quantity-popover-container{% if has_qty_rules or has_vol_pricing %} quantity-popover-container--hover{% endif %}">
                          {%- if has_qty_rules or has_vol_pricing -%}
                            <button
                              type="button"
                              aria-expanded="false"
                              class="quantity-popover__info-button quantity-popover__info-button--icon-only button button--tertiary small-hide medium-hide"
                            >
                              {{- 'icon-info.svg' | inline_asset_content -}}
                            </button>
                          {%- endif -%}

                          <quantity-input class="quantity cart-quantity">
                            <button class="quantity__button" name="minus" type="button">
                              <span class="visually-hidden">
                                {{- 'products.product.quantity.decrease' | t: product: item.product.title | escape | upcase -}}
                              </span>
                              <span class="svg-wrapper">{{- 'icon-minus.svg' | inline_asset_content -}}</span>
                            </button>
                            <input
                              class="quantity__input"
                              data-quantity-variant-id="{{ item.variant.id }}"
                              type="number"
                              name="updates[]"
                              value="{{ item.quantity }}"
                              {% # theme-check-disable %}
                              data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                              min="0"
                              data-min="{{ item.variant.quantity_rule.min }}"
                              {% if item.variant.quantity_rule.max != null %}
                                max="{{ item.variant.quantity_rule.max }}"
                              {% endif %}
                              step="{{ item.variant.quantity_rule.increment }}"
                              {% # theme-check-enable %}
                              aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape | upcase }}"
                              id="Quantity-{{ item.index | plus: 1 }}"
                              data-index="{{ item.index | plus: 1 }}"
                            >
                            <button class="quantity__button" name="plus" type="button">
                              <span class="visually-hidden">
                                {{- 'products.product.quantity.increase' | t: product: item.product.title | escape | upcase -}}
                              </span>
                              <span class="svg-wrapper">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
                            </button>
                          </quantity-input>
                        </div>

                        <cart-remove-button
                          id="Remove-{{ item.index | plus: 1 }}"
                          data-index="{{ item.index | plus: 1 }}"
                        >
                          <a
                            href="{{ item.url_to_remove }}"
                            class="cart-luxury__remove"
                            aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape | upcase }}"
                          >
                            <span class="svg-wrapper">{{- 'icon-remove.svg' | inline_asset_content -}}</span>
                          </a>
                        </cart-remove-button>
                      </div>

                      {%- if has_qty_rules or has_vol_pricing -%}
                        <button
                          type="button"
                          class="quantity-popover__info-button quantity-popover__info-button--icon-with-label button button--tertiary large-up-hide"
                          aria-expanded="false"
                        >
                          {{- 'icon-info.svg' | inline_asset_content -}}
                          <span>
                            {%- if has_vol_pricing -%}
                              {{ 'products.product.volume_pricing.note' | t | upcase }}
                            {%- elsif has_qty_rules -%}
                              {{ 'products.product.quantity.note' | t | upcase }}
                            {%- endif -%}
                          </span>
                        </button>
                      {%- endif -%}

                      {%- if has_vol_pricing or has_qty_rules -%}
                        <div
                          class="cart-items__info global-settings-popup quantity-popover__info"
                          tabindex="-1"
                          hidden
                        >
                          {%- if has_qty_rules == false -%}
                            <span class="volume-pricing-label caption">
                              {{- 'products.product.volume_pricing.title' | t | upcase -}}
                            </span>
                          {%- endif -%}

                          <div class="quantity__rules caption">
                            {%- if item.variant.quantity_rule.increment > 1 -%}
                              <span class="divider">
                                {{ 'products.product.quantity.multiples_of' | t: quantity: item.variant.quantity_rule.increment | upcase }}
                              </span>
                            {%- endif -%}
                            {%- if item.variant.quantity_rule.min > 1 -%}
                              <span class="divider">
                                {{ 'products.product.quantity.min_of' | t: quantity: item.variant.quantity_rule.min | upcase }}
                              </span>
                            {%- endif -%}
                            {%- if item.variant.quantity_rule.max != null -%}
                              <span class="divider">
                                {{ 'products.product.quantity.max_of' | t: quantity: item.variant.quantity_rule.max | upcase }}
                              </span>
                            {%- endif -%}
                          </div>

                          <button
                            class="button-close button button--tertiary large-up-hide"
                            type="button"
                            aria-label="{{ 'accessibility.close' | t | upcase }}"
                          >
                            <span class="svg-wrapper">{{- 'icon-close.svg' | inline_asset_content -}}</span>
                          </button>

                          {%- if item.variant.quantity_price_breaks.size > 0 -%}
                            <volume-pricing class="parent-display">
                              <ul class="list-unstyled">
                                <li>
                                  <span>{{ item.variant.quantity_rule.min }}+</span>
                                  {%- assign price = item.variant.price | money_with_currency -%}
                                  <span>{{ 'sections.quick_order_list.each' | t: money: price | upcase }}</span>
                                </li>
                                {%- for price_break in item.variant.quantity_price_breaks -%}
                                  <li>
                                    <span>{{ price_break.minimum_quantity }}<span aria-hidden="true">+</span></span>
                                    {%- assign price = price_break.price | money_with_currency -%}
                                    <span>{{ 'sections.quick_order_list.each' | t: money: price | upcase }}</span>
                                  </li>
                                {%- endfor -%}
                              </ul>
                            </volume-pricing>
                          {%- endif -%}
                        </div>
                      {%- endif -%}

                      <div class="cart-luxury__error" id="Line-item-error-{{ item.index | plus: 1 }}" role="alert">
                        <small class="cart-item__error-text"></small>
                        <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
                      </div>
                    </quantity-popover>
                  </div>


                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      </div>

      <p class="visually-hidden" id="cart-live-region-text" aria-live="polite" role="status"></p>
      <p class="visually-hidden" id="shopping-cart-line-item-status" aria-live="polite" aria-hidden="true" role="status">
        {{ 'accessibility.loading' | t | upcase }}
      </p>
    </form>

  </div>
</cart-items>

{% schema %}
{
  "name": "t:sections.main-cart-items.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
