<script>
  (function() {
    class LuxuryIconCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
      connectedCallback() {
        this.style.display = 'block';
        this.initCarousel();
      }
      initCarousel() {
        const track = this.querySelector('.ai-lux-track-{{ ai_gen_id }}');
        if (!track) return;
        const items = track.querySelectorAll('.ai-lux-item-{{ ai_gen_id }}');
        if (items.length === 0) return;
        const halfCount = Math.floor(items.length / 2);
        let totalWidth = 0;
        const gap = parseInt('{{ block.settings.icon_spacing }}') || 80;
        for (let i = 0; i < halfCount; i++) {
          totalWidth += items[i].offsetWidth + gap;
          const divider = items[i].nextElementSibling;
          if (divider && divider.classList.contains('ai-lux-divider-{{ ai_gen_id }}')) {
            totalWidth += divider.offsetWidth + gap;
          }
        }
        const speed = parseInt('{{ block.settings.scroll_speed }}') || 40;
        const duration = totalWidth / speed;
        track.style.setProperty('--ai-lux-duration-{{ ai_gen_id }}', duration + 's');
        this.style.setProperty('--ai-lux-duration-{{ ai_gen_id }}', duration + 's');
      }
    }
    if (!customElements.get('luxury-icon-carousel-{{ ai_gen_id }}')) {
      customElements.define('luxury-icon-carousel-{{ ai_gen_id }}', LuxuryIconCarousel{{ ai_gen_id }});
    }
  })();
</script>
{% schema %}
{
  "name": "Luxury Icon Carousel",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll speed",
      "info": "Pixels per second — lower is slower",
      "min": 10,
      "max": 120,
      "step": 5,
      "default": 40
    },
    {
      "type": "select",
      "id": "scroll_direction",
      "label": "Scroll direction",
      "options": [
        { "value": "normal", "label": "Left" },
        { "value": "reverse", "label": "Right" }
      ],
      "default": "normal"
    },
    {
      "type": "select",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "options": [
        { "value": "paused", "label": "Yes" },
        { "value": "running", "label": "No" }
      ],
      "default": "paused"
    },
    {
      "type": "range",
      "id": "fade_width",
      "label": "Edge fade width",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "header",
      "content": "Icon style"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 40,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "mobile_icon_size",
      "label": "Mobile icon size",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "stroke_weight",
      "label": "Line weight",
      "min": 0.5,
      "max": 3,
      "step": 0.5,
      "default": 1
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "icon_spacing",
      "label": "Space between icons",
      "min": 40,
      "max": 250,
      "step": 10,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "mobile_icon_spacing",
      "label": "Mobile space between icons",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "icon_max_width",
      "label": "Icon column width",
      "min": 120,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 220
    },
    {
      "type": "range",
      "id": "mobile_item_width",
      "label": "Mobile icon column width",
      "min": 100,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 160
    },
    {
      "type": "range",
      "id": "item_horizontal_padding",
      "label": "Item horizontal padding",
