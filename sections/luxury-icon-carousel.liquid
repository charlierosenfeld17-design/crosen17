{% doc %}
  @prompt
    A horizontal rotating/looping carousel of luxury e-commerce icons with smooth infinite scroll animation. Icons are spread out with generous spacing. Aesthetic: Quiet luxury, sophisticated, architectural, premium. Subtext smaller under icon text, centered paragraph form. Fully customizable: icon spacing, color schemes, font sizes, animation speed, direction.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-lux-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background: {{ block.settings.background_color }};
    overflow: hidden;
    position: relative;
  }
  .ai-lux-carousel-{{ ai_gen_id }}::before,
  .ai-lux-carousel-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: {{ block.settings.fade_width }}px;
    z-index: 2;
    pointer-events: none;
  }
  .ai-lux-carousel-{{ ai_gen_id }}::before {
    left: 0;
    background: linear-gradient(to right, {{ block.settings.background_color }}, {{ block.settings.background_color | color_modify: 'alpha', 0 }});
  }
  .ai-lux-carousel-{{ ai_gen_id }}::after {
    right: 0;
    background: linear-gradient(to left, {{ block.settings.background_color }}, {{ block.settings.background_color | color_modify: 'alpha', 0 }});
  }
  .ai-lux-track-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: {{ block.settings.icon_spacing }}px;
    width: max-content;
    animation: aiLuxScroll{{ ai_gen_id }} var(--ai-lux-duration-{{ ai_gen_id }}, 30s) linear infinite;
    animation-direction: {{ block.settings.scroll_direction }};
  }
  .ai-lux-carousel-{{ ai_gen_id }}:hover .ai-lux-track-{{ ai_gen_id }} {
    animation-play-state: {{ block.settings.pause_on_hover }};
  }
  @keyframes aiLuxScroll{{ ai_gen_id }} {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .ai-lux-item-{{ ai_gen_id }} {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: {{ block.settings.text_spacing }}px;
    width: {{ block.settings.icon_max_width }}px;
    min-width: {{ block.settings.icon_max_width }}px;
    padding: 0 {{ block.settings.item_horizontal_padding }}px;
  }
  .ai-lux-icon-wrap-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .ai-lux-svg-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    stroke: {{ block.settings.icon_color }};
    fill: none;
    stroke-width: {{ block.settings.stroke_weight }};
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ai-lux-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    text-align: center;
    letter-spacing: {{ block.settings.letter_spacing }}px;
    text-transform: {{ block.settings.text_transform }};
    font-weight: {{ block.settings.text_weight }};
    line-height: {{ block.settings.text_line_height }};
    margin: 0;
    white-space: nowrap;
  }
  .ai-lux-subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_size }}px;
    color: {{ block.settings.subtext_color }};
    text-align: center;
    line-height: {{ block.settings.subtext_line_height }};
    margin: 0;
    padding: 0 {{ block.settings.subtext_padding }}px;
    font-weight: {{ block.settings.subtext_weight }};
    max-width: 100%;
  }
  .ai-lux-divider-{{ ai_gen_id }} {
    flex: 0 0 auto;
    width: 1px;
    height: {{ block.settings.divider_height }}px;
    background: {{ block.settings.divider_color }};
    align-self: center;
    opacity: {{ block.settings.divider_opacity }};
  }
  @media screen and (max-width: 749px) {
    .ai-lux-track-{{ ai_gen_id }} {
      gap: {{ block.settings.mobile_icon_spacing }}px;
    }
    .ai-lux-item-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_item_width }}px;
      min-width: {{ block.settings.mobile_item_width }}px;
    }
    .ai-lux-svg-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_icon_size }}px;
      height: {{ block.settings.mobile_icon_size }}px;
    }
    .ai-lux-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_text_size }}px;
    }
    .ai-lux-subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_subtext_size }}px;
    }
    .ai-lux-carousel-{{ ai_gen_id }}::before,
    .ai-lux-carousel-{{ ai_gen_id }}::after {
      width: {{ block.settings.fade_width | divided_by: 2 }}px;
    }
  }
