{% doc %}
  @prompt
    Luxury popup for Homepage Only.
    Layout: Side-by-Side (Desktop), Stacked (Mobile).
    Features: Pre-headline, elegant typography, gold accents,
    trust icons (Free Shipping, Tarnish Free, Hypoallergenic),
    shows on every refresh, no buttons.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  @keyframes ai-fadeIn-{{ ai_gen_id }} {
    from { opacity: 0; transform: scale(0.97); }
    to { opacity: 1; transform: scale(1); }
  }

  @keyframes ai-slideUp-{{ ai_gen_id }} {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .ai-discount-popup-{{ ai_gen_id }} {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 9999;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
  }

  .ai-discount-popup-{{ ai_gen_id }}.active {
    display: flex;
    animation: ai-fadeIn-{{ ai_gen_id }} 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .ai-discount-popup-content-{{ ai_gen_id }} {
    position: relative;
    background-color: {{ block.settings.background_color }};
    max-width: {{ block.settings.popup_max_width }}px;
    width: 100%;
    display: flex;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.25), 0 0 0 1px rgba(255, 255, 255, 0.05);
  }

  .ai-discount-popup-image-{{ ai_gen_id }} {
    flex: 0 0 50%;
    position: relative;
  }

  .ai-discount-popup-image-{{ ai_gen_id }} img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-discount-popup-text-{{ ai_gen_id }} {
    flex: 0 0 50%;
    padding: 48px 40px 36px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .ai-popup-top-section-{{ ai_gen_id }} {
    width: 100%;
    margin-bottom: 20px;
    display: flex;
    justify-content: center;
  }

  .ai-discount-popup-pre-headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.pre_headline_size }}px;
    color: {{ block.settings.accent_color }};
    margin: 0 0 8px 0;
    text-transform: uppercase;
    letter-spacing: 3px;
    font-weight: 500;
    animation: ai-slideUp-{{ ai_gen_id }} 0.5s ease-out 0.2s both;
  }

  .ai-discount-popup-divider-{{ ai_gen_id }} {
    width: 40px;
    height: 1px;
    background-color: {{ block.settings.accent_color }};
    margin: 0 auto 16px;
    border: none;
    opacity: 0.6;
    animation: ai-slideUp-{{ ai_gen_id }} 0.5s ease-out 0.25s both;
  }

  .ai-discount-popup-headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    font-weight: 300;
    color: {{ block.settings.headline_color }};
    margin: 0 0 12px;
    line-height: 1.05;
    letter-spacing: -0.5px;
    animation: ai-slideUp-{{ ai_gen_id }} 0.5s ease-out 0.3s both;
  }

  .ai-discount-popup-subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 28px;
    line-height: 1.6;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 400;
    animation: ai-slideUp-{{ ai_gen_id }} 0.5s ease-out 0.35s both;
  }

  /* Trust Icons */
  .ai-popup-trust-icons-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 24px;
    width: 100%;
    padding-top: 20px;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    margin-top: auto;
    animation: ai-slideUp-{{ ai_gen_id }} 0.5s ease-out 0.45s both;
  }

  .ai-popup-trust-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .ai-popup-trust-item-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    color: {{ block.settings.accent_color }};
    opacity: 0.85;
  }

  .ai-popup-trust-item-{{ ai_gen_id }} span {
    font-size: 9px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
    font-weight: 500;
    white-space: nowrap;
  }

  .ai-discount-popup-close-{{ ai_gen_id }} {
    position: absolute;
    top: 14px;
    right: 14px;
    background: {{ block.settings.background_color }};
    border-radius: 50%;
    border: none;
    cursor: pointer;
    padding: 6px;
    z-index: 10;
    color: {{ block.settings.headline_color }};
    display: flex;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .ai-discount-popup-close-{{ ai_gen_id }}:hover {
    transform: scale(1.1);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
  }

  @media screen and (max-width: 749px) {
    .ai-discount-popup-content-{{ ai_gen_id }} {
      flex-direction: column;
      max-height: 90vh;
      width: 95%;
    }
    .ai-discount-popup-image-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.mobile_image_height }}px;
      width: 100%;
    }
    .ai-discount-popup-text-{{ ai_gen_id }} {
      flex: 1 1 auto;
      padding: 28px 24px 24px;
    }
    .ai-popup-trust-icons-{{ ai_gen_id }} {
      gap: 16px;
    }
    .ai-popup-trust-item-{{ ai_gen_id }} span {
      font-size: 8px;
      letter-spacing: 1px;
    }
  }
{% endstyle %}

<discount-popup-{{ ai_gen_id }}
  class="ai-discount-popup-{{ ai_gen_id }}"
  data-delay="{{ block.settings.delay_seconds }}"
  data-homepage-only="{{ block.settings.homepage_only }}"
>
  <div class="ai-discount-popup-content-{{ ai_gen_id }}">
    <button class="ai-discount-popup-close-{{ ai_gen_id }}" aria-label="Close popup">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>

    <div class="ai-discount-popup-image-{{ ai_gen_id }}">
      {% if block.settings.popup_image %}
        <img src="{{ block.settings.popup_image | image_url: width: 800 }}" alt="{{ block.settings.popup_image.alt | escape }}" loading="lazy">
      {% else %}
        <div style="width:100%; height:100%; background:#f4f4f4; display:flex; align-items:center; justify-content:center;">
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="ai-discount-popup-text-{{ ai_gen_id }}">
      <div class="ai-popup-top-section-{{ ai_gen_id }}">
        {% if block.settings.top_icon %}
           <img src="{{ block.settings.top_icon | image_url: width: 100 }}" style="max-width: 60px;">
        {% endif %}
      </div>

      {% if block.settings.pre_headline != blank %}
        <p class="ai-discount-popup-pre-headline-{{ ai_gen_id }}">{{ block.settings.pre_headline }}</p>
      {% endif %}

      <hr class="ai-discount-popup-divider-{{ ai_gen_id }}">

      {% if block.settings.headline != blank %}
        <h2 class="ai-discount-popup-headline-{{ ai_gen_id }}">{{ block.settings.headline }}</h2>
      {% endif %}

      {% if block.settings.subtext != blank %}
        <p class="ai-discount-popup-subtext-{{ ai_gen_id }}">{{ block.settings.subtext }}</p>
      {% endif %}

      <!-- Trust Icons -->
      <div class="ai-popup-trust-icons-{{ ai_gen_id }}">
        <div class="ai-popup-trust-item-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="6" width="22" height="12" rx="2" ry="2"></rect>
            <path d="M1 10h22"></path>
          </svg>
          <span>Free Shipping $100+</span>
        </div>
        <div class="ai-popup-trust-item-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            <polyline points="9 12 11 14 15 10"></polyline>
          </svg>
          <span>Tarnish Free</span>
        </div>
        <div class="ai-popup-trust-item-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
          <span>Hypoallergenic</span>
        </div>
      </div>
    </div>
  </div>
</discount-popup-{{ ai_gen_id }}>

<script>
  (function() {
    if (!customElements.get('discount-popup-{{ ai_gen_id }}')) {
      class DiscountPopup{{ ai_gen_id }} extends HTMLElement {
        constructor() {
          super();
        }
        connectedCallback() {
          this.closeButton = this.querySelector('.ai-discount-popup-close-{{ ai_gen_id }}');
          this.delay = parseInt(this.dataset.delay) * 1000;
          this.homepageOnly = this.dataset.homepageOnly === 'true';

          this.closeButton.addEventListener('click', () => this.closePopup());
          this.addEventListener('click', (e) => { if (e.target === this) this.closePopup(); });

          this.checkAndShow();
        }
        checkAndShow() {
          const isHomepage = window.location.pathname === '/' || window.location.pathname === '/en-us' || window.location.pathname.includes('index');
          if (!this.homepageOnly || isHomepage) {
            setTimeout(() => this.classList.add('active'), this.delay);
          }
        }
        closePopup() {
          this.classList.remove('active');
        }
      }
      customElements.define('discount-popup-{{ ai_gen_id }}', DiscountPopup{{ ai_gen_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "Luxury Discount Popup",
  "settings": [
    { "type": "checkbox", "id": "homepage_only", "label": "Show on homepage only", "default": true },
    { "type": "range", "id": "delay_seconds", "min": 0, "max": 10, "step": 1, "unit": "s", "label": "Delay", "default": 2 },
    { "type": "range", "id": "popup_max_width", "min": 600, "max": 1000, "step": 50, "unit": "px", "label": "Max Width", "default": 800 },
    { "type": "range", "id": "border_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Border Radius", "default": 4 },
    { "type": "header", "content": "Visuals" },
    { "type": "image_picker", "id": "popup_image", "label": "Main Image (Left Side)" },
    { "type": "image_picker", "id": "top_icon", "label": "Top Center Icon/Logo" },
    { "type": "range", "id": "mobile_image_height", "min": 150, "max": 400, "step": 25, "unit": "px", "label": "Mobile Image Height", "default": 250 },
    { "type": "header", "content": "Content" },
    { "type": "inline_richtext", "id": "pre_headline", "label": "Pre-Headline", "default": "EXCLUSIVE OFFER" },
    { "type": "range", "id": "pre_headline_size", "min": 10, "max": 24, "step": 1, "unit": "px", "label": "Pre-Headline Size", "default": 11 },
    { "type": "inline_richtext", "id": "headline", "label": "Headline", "default": "15% OFF" },
    { "type": "range", "id": "headline_size", "min": 24, "max": 72, "step": 4, "unit": "px", "label": "Headline Size", "default": 48 },
    { "type": "inline_richtext", "id": "subtext", "label": "Subtext", "default": "USE CODE: NORTH15" },
    { "type": "range", "id": "subtext_size", "min": 12, "max": 24, "step": 1, "unit": "px", "label": "Subtext Size", "default": 14 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#faf8f5" },
    { "type": "color", "id": "headline_color", "label": "Headline", "default": "#1a1a1a" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#6b6b6b" },
    { "type": "color", "id": "accent_color", "label": "Accent (Gold)", "default": "#b8977e" }
  ],
  "presets": [{ "name": "Luxury Discount Popup" }]
}
{% endschema %}
