{% comment %}
  Splash Screen / Loading Overlay
  Shows the store logo on a full-screen overlay, then fades out to reveal site content.

  Usage: {% render 'splash-screen' %}
  Place immediately after the opening <body> tag in layout/theme.liquid.
{% endcomment %}

<style>
  .splash-screen {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #ffffff;
    transition: opacity 0.6s ease, visibility 0.6s ease;
  }

  .splash-screen.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .splash-screen__logo {
    width: 180px;
    max-width: 60vw;
    opacity: 0;
    transform: scale(0.92);
    animation: splashFadeIn 0.8s ease forwards;
  }

  @keyframes splashFadeIn {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>

<div class="splash-screen" id="SplashScreen" aria-hidden="true">
  <img
    class="splash-screen__logo"
    src="https://cdn.shopify.com/s/files/1/0725/2806/8844/files/ABV_Logo_PNG_7168a571-92c7-40f8-ad8d-36ee9f5f301a.png?v=1774345149"
    alt="{{ shop.name }}"
    width="180"
    height="180"
    fetchpriority="high"
  >
</div>

<script>
  (function() {
    var splash = document.getElementById('SplashScreen');
    if (!splash) return;

    /* Wait for the page to fully load, then hold briefly so the logo is visible */
    window.addEventListener('load', function() {
      setTimeout(function() {
        splash.classList.add('is-hidden');
        /* Remove from DOM after the CSS transition finishes */
        splash.addEventListener('transitionend', function() {
          splash.remove();
        }, { once: true });
      }, 1200);
    });

    /* Safety net: hide the splash after 4s even if 'load' hasn't fired (slow networks) */
    setTimeout(function() {
      if (splash && !splash.classList.contains('is-hidden')) {
        splash.classList.add('is-hidden');
        splash.addEventListener('transitionend', function() {
          splash.remove();
        }, { once: true });
      }
    }, 4000);
  })();
</script>
