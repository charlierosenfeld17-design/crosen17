{% comment %}
  Splash Screen / Loading Overlay
  Shows the store logo on a full-screen overlay, then fades out to reveal site content.

  Usage: {% render 'splash-screen' %}
  Place immediately after the opening <body> tag in layout/theme.liquid.
{% endcomment %}

<style>
  .splash-screen {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #ffffff;
    transition: opacity 0.6s ease;
  }

  .splash-screen__logo {
    width: auto;
    height: auto;
    max-width: 100px;
    max-height: 100px;
    object-fit: contain;
    opacity: 0;
    animation: splashFadeIn 0.6s ease forwards, splashPulse 1.8s ease-in-out 0.6s infinite;
  }

  @keyframes splashFadeIn {
    to {
      opacity: 1;
    }
  }

  @keyframes splashPulse {
    0%, 100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.06);
      opacity: 0.8;
    }
  }
</style>

<div class="splash-screen" id="SplashScreen" aria-hidden="true">
  <img
    class="splash-screen__logo"
    src="https://cdn.shopify.com/s/files/1/0725/2806/8844/files/ABV_Logo_PNG_7168a571-92c7-40f8-ad8d-36ee9f5f301a.png?v=1774345149"
    alt="{{ shop.name }}"
    width="100"
    height="100"
    fetchpriority="high"
  >
</div>

<script>
  (function() {
    var splash = document.getElementById('SplashScreen');
    if (!splash) return;

    function hideSplash() {
      splash.style.opacity = '0';
      splash.style.pointerEvents = 'none';
      setTimeout(function() {
        splash.style.display = 'none';
      }, 700);
    }

    /* Show for 1.5s then fade out — no dependency on load event */
    setTimeout(hideSplash, 1500);
  })();
</script>
